# Client-visible (build time)
PUBLIC_GSC_VERIFICATION=
# Optional ad/measurement tags (build time). OFF unless set; do NOT set without amending CLAUDE.md rule 7, the
# privacy policy, adding a consent banner and updating vercel.json's CSP (docs/LAUNCH.md, "Optional ad tags").
PUBLIC_GA4_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_META_PIXEL_ID=
# Public contact address (owner decision; never invented). Unset = /contact and /privacy say
# "coming soon" AND the rate-alerts signup is hidden and /api/subscribe refuses signups.
PUBLIC_CONTACT_EMAIL=

# Server-only (Vercel Functions). Local dev: `vercel env pull .env.local`.
# Never commit real values; never read SUPABASE_DB_* from site code. SUPABASE_SECRET_KEY is read ONLY by the lead/estimate API routes.
NREL_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Lead capture (Phase 2). Server-only except where noted.
SUPABASE_SECRET_KEY=
CALL_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
LEAD_SIGNING_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Build time (public). TrustedForm records the session: needs rule-7 amendment + privacy update + CSP (docs/LAUNCH.md).
PUBLIC_TRUSTEDFORM_ENABLED=
PUBLIC_RESPONSE_WINDOW=
