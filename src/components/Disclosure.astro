---
import { disclosureText } from '../lib/offers/disclosure';

interface Props {
  /** offers.disclosure_key; omit for the standard wording. */
  disclosureKey?: string;
}
const { disclosureKey } = Astro.props;
const text = disclosureKey ? disclosureText(disclosureKey) : null;
---
<aside class="rounded-lg border border-sun-300 bg-sun-50 px-4 py-3 text-sm text-stone-800" aria-label="Affiliate disclosure">
  <strong class="font-semibold">Disclosure:</strong>
  {text ?? 'Some links below are affiliate links. If you click one and sign up, RayValue may earn a commission at no extra cost to you.'}
  <a href="/affiliate-disclosure" class="text-sun-ink underline underline-offset-2 hover:text-stone-900">Learn more</a>.
</aside>
