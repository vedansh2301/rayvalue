---
import { utilityPagePath, utilityPagesForState } from '../../lib/utility/pages';
interface Props { state: 'FL' | 'CA'; heading?: string; exclude?: string; chips?: boolean }
const { state, heading, exclude, chips = false } = Astro.props;
const pages = utilityPagesForState(state).filter((p) => p.slug !== exclude);
---
<nav aria-label={heading ?? 'Solar by utility'}>
  {heading && <h2 class="text-xl font-semibold text-stone-900">{heading}</h2>}
  <ul class:list={['flex flex-wrap', chips ? 'gap-2' : 'gap-x-4 gap-y-1', heading && 'mt-3']}>
    {pages.map((p) => (
      <li><a href={utilityPagePath(p)} class={chips ? 'inline-flex items-center rounded-full border border-stone-300 px-3 py-1.5 text-sm font-medium text-sun-ink hover:border-stone-500 hover:text-stone-900' : 'inline-flex min-h-11 items-center text-sun-ink underline underline-offset-4 hover:text-stone-900'}>Solar with {p.short}</a></li>
    ))}
  </ul>
</nav>
