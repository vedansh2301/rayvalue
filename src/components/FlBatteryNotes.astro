---
import { FL_BATTERY_CLOSING, FL_BATTERY_INTRO, FL_BATTERY_NOTES, FL_BATTERY_TITLE } from '../lib/content/fl-battery';
---
<section aria-labelledby="fl-battery-heading" class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-8">
  <h2 id="fl-battery-heading" class="text-xl font-semibold text-stone-900">{FL_BATTERY_TITLE}</h2>
  <p class="mt-2 leading-7 text-stone-700">{FL_BATTERY_INTRO}</p>
  <dl class="mt-4 space-y-4">
    {FL_BATTERY_NOTES.map((n) => (
      <div>
        <dt class="font-semibold text-stone-900">{n.heading}</dt>
        <dd class="mt-1 leading-7 text-stone-700">{n.body}</dd>
      </div>
    ))}
  </dl>
  <p class="mt-4 leading-7 text-stone-700">{FL_BATTERY_CLOSING}</p>
</section>
