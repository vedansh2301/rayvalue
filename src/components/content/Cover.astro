---
/**
 * Article cover for cards and the article header. With a `cover` photo (frontmatter `cover` + `coverAlt`) it renders a
 * responsive AVIF/WebP <Picture> cropped to the box; without one it falls back to the generated topic cover:
 * a tinted panel with a big two-tone glyph (deterministic, decorative).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon, { type IconName } from '../icons/Icon';
import type { Topic, StateKey } from '../../lib/content/cards';

interface Props {
  topic: Topic;
  state: StateKey;
  class?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  /** `sizes` for the photo; the default suits a full-width card on phones and a third of the shell on desktop. */
  sizes?: string;
  /** Above-the-fold photo: load eagerly with high fetch priority. */
  eager?: boolean;
}
const { topic, state, class: cls = '', cover, coverAlt, sizes = '(min-width: 1280px) 384px, (min-width: 768px) calc(50vw - 3rem), calc(100vw - 2rem)', eager = false } = Astro.props;
const GLYPH: Record<Topic, IconName> = { map: 'map', battery: 'battery', bill: 'bill', house: 'home', sun: 'sun', scale: 'scale', chart: 'chart' };
const TINT: Record<StateKey, string> = { FL: 'bg-sky-100', CA: 'bg-emerald-100', both: 'bg-sun-100' };
const WIDTHS = [400, 640, 960, 1280].filter((w) => !cover || w <= cover.width);
---
{cover ? (
  <div class={`relative overflow-hidden bg-stone-200 ${cls}`}>
    <Picture
      src={cover}
      alt={coverAlt ?? ''}
      formats={['avif', 'webp']}
      widths={WIDTHS}
      sizes={sizes}
      width={960}
      height={Math.round((960 * cover.height) / cover.width)}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
  </div>
) : (
  <div class={`relative flex items-center justify-center overflow-hidden ${TINT[state]} ${cls}`} aria-hidden="true">
    <svg viewBox="0 0 160 90" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid slice" fill="none" focusable="false">
      <circle cx="136" cy="14" r="34" fill="#fbbf24" opacity="0.35"></circle>
      <circle cx="14" cy="86" r="26" fill="#ffffff" opacity="0.55"></circle>
      <path d="M0 74q40-14 80-4t80-8v28H0z" fill="#ffffff" opacity="0.5"></path>
    </svg>
    <span class="relative flex size-16 items-center justify-center rounded-2xl bg-white shadow-sm ring-1 ring-stone-900/10 text-stone-900"><Icon name={GLYPH[topic]} size={36} /></span>
  </div>
)}
