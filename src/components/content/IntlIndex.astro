---
/** Plain index of one country's published, indexable guides or posts: /<cc>/guides and /<cc>/blog. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { displayDate } from '../../lib/dates';
import { articleIndexPath, articlePath, countrySegment } from '../../lib/content/paths';
import { uiText } from '../../lib/i18n/ui';
import type { ImageMetadata } from 'astro';
import ArticleCard from '../home/ArticleCard.astro';
import { coverTopic, stateKey, type StateKey, type Topic } from '../../lib/content/cards';
import { countryName } from '../../lib/content/country-nav';

interface Entry { id: string; data: { title: string; description: string; updated?: Date; published?: Date; country: string; lang: string; noindex: boolean; cover?: ImageMetadata; coverAlt?: string; topic?: Topic; tags?: string[]; state?: StateKey } }
interface Props { collection: 'guides' | 'blog'; country: string; entries: Entry[] }
const { collection, country, entries } = Astro.props;
// Only indexable entries are listed; with none, the page is noindex (drafts are never passed in).
const listed = entries.filter((e) => !e.data.noindex).sort((a, b) => (b.data.updated ?? b.data.published ?? new Date(0)).getTime() - (a.data.updated ?? a.data.published ?? new Date(0)).getTime());
const lang = entries[0]?.data.lang ?? 'en';
const ui = uiText(lang);
const heading = collection === 'guides' ? ui.guides : ui.blog;
const path = articleIndexPath(collection, country);
---
<BaseLayout title={heading} description={`RayValue ${heading.toLowerCase()}: independent solar and home-battery articles, each with its sources listed.`} path={path} noindex={listed.length === 0} lang={lang}>
  <div class="page [&>ul]:max-w-none">
    <Breadcrumbs items={[{ label: ui.home, href: `/${countrySegment(country)}` }, { label: heading }]} />
    <h1>{heading}</h1>
    {listed.length === 0 ? <p>No articles are published here yet.</p> : (
      <ul class="not-prose mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {listed.map((e) => (
          <li>
            <ArticleCard href={articlePath(collection, e.id, undefined, e.data.country)} title={e.data.title} description={e.data.description} lang={e.data.lang} segment={countrySegment(e.data.country)} countryName={countryName(countrySegment(e.data.country), lang)} tag={collection === 'guides' ? 'Guide' : 'Post'} compact placement={`${collection}_country_index`} cover={e.data.cover} coverAlt={e.data.cover ? '' : undefined} topic={coverTopic({ topic: e.data.topic, tags: e.data.tags, title: e.data.title, state: e.data.state })} state={stateKey(e.data.state)} />
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
