---
/**
 * Answer-first "key numbers" card for city and utility pages. No logic: it prints a block prepared by
 * lib/city/key-numbers.ts or lib/utility/key-numbers.ts (every line has its source link and checked-on date).
 * Renders nothing when the block has no items. Plain bordered card; no seals or badges.
 */
import type { KeyNumbersBlock } from '../../lib/seo/key-numbers';

interface Props {
  id: string;
  heading: string;
  block: KeyNumbersBlock;
}
const { id, heading, block } = Astro.props;
---
{block.items.length > 0 && (
  <section aria-labelledby={id} class="mt-6 rounded-lg border border-stone-200 bg-white p-5">
    <h2 id={id} class="!mt-0 text-xl font-bold tracking-tight text-stone-900">{heading}</h2>
    {block.answer && <p class="mt-2 text-stone-800">{block.answer}</p>}
    <dl class="mt-4 grid gap-x-6 gap-y-4 sm:grid-cols-2">
      {block.items.map((it) => (
        <div>
          <dt class="text-sm text-stone-600">{it.label}</dt>
          <dd class="font-semibold text-stone-900">{it.value}</dd>
          <dd class="text-sm text-stone-600">
            {it.source ? <>Source: <a href={it.source.url} rel="noopener">{it.source.label}</a></> : 'Source: our data'}
            {it.checkedOn ? <>, checked {it.checkedOn}</> : null}
          </dd>
          {it.note && <dd class="text-sm text-stone-600">{it.note}</dd>}
        </div>
      ))}
    </dl>
    {block.checkedOn && <p class="mt-4 text-sm text-stone-600">Figures checked on {block.checkedOn}.</p>}
  </section>
)}
