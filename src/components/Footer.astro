---
const links = [
  { href: '/calculator/florida', label: 'Florida calculator' },
  { href: '/calculator/california', label: 'California calculator' },
  { href: '/about', label: 'About' },
  { href: '/guides', label: 'Guides' },
  { href: '/blog', label: 'Blog' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/affiliate-disclosure', label: 'Affiliate Disclosure' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: '/contact', label: 'Contact' },
];
---
<footer class="mt-auto border-t border-stone-200 bg-white">
  <div class="shell py-8 text-sm text-stone-600">
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-3">
        {links.map((l) => (
          <li><a href={l.href} class="inline-flex min-h-11 items-center text-stone-700 hover:text-stone-900 hover:underline underline-offset-4">{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="mt-4">RayValue is an independent site, not affiliated with any utility or government agency.</p>
    <p class="mt-1">&copy; {new Date().getFullYear()} RayValue</p>
  </div>
</footer>
