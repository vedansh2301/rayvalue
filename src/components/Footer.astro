---
import { publishedCityLinks } from '../lib/seo/city-links';
import { calcPath } from '../lib/paths';
import { utilityPagePath, utilityPagesForState } from '../lib/utility/pages';
import { loadCountryCounts, loadMenuSegments } from '../lib/country-nav-load';
import { countryMenu, navContext } from '../lib/nav';
import { liveCalculators } from '../lib/home/global-home';
import { uiText } from '../lib/i18n/ui';
import SunMark from './SunMark.astro';
// One footer everywhere: countries grouped by region, calculators, company and legal. US pages add the per-state
// utility and city links (SEO internal links); the US-only "Do Not Sell" link stays off other countries' pages.
const { legalOnly = false, lang = 'en' } = Astro.props as { legalOnly?: boolean; lang?: string };
const ui = uiText(lang);
const counts = legalOnly ? new Map() : await loadCountryCounts();
const segments = legalOnly ? [] : await loadMenuSegments();
const ctx = navContext({ path: Astro.url.pathname, known: [...counts.keys()], counts, lang });
const menu = countryMenu(segments, ctx.segment);
const calculators = liveCalculators();
const showUs = !legalOnly && ctx.kind === 'us';
const cityLinks = showUs ? await publishedCityLinks() : [];
const byState = (['FL', 'CA'] as const).map((st) => ({
  name: st === 'FL' ? 'Florida' : 'California',
  calc: calcPath(st),
  utilities: utilityPagesForState(st).map((p) => ({ href: utilityPagePath(p), label: p.short })),
  cities: cityLinks.filter((c) => c.state === st).map((c) => ({ href: c.href, label: c.name })),
}));
type Link = { href: string; label: string };
const company: Link[] = [
  { href: '/methodology', label: ui.methodology },
  { href: '/about', label: ui.about },
  { href: '/contact', label: ui.contact },
  { href: '/affiliate-disclosure', label: 'Affiliate Disclosure' },
  { href: '/privacy', label: ui.privacy },
  { href: '/terms', label: ui.terms },
  ...(ctx.kind === 'country' ? [] : [{ href: '/privacy/request?type=do_not_sell', label: 'Do Not Sell or Share My Personal Information' }]),
  { href: '/credits', label: 'Photo credits' },
];
const LEGAL = new Set(['/affiliate-disclosure', '/privacy', '/terms', '/privacy/request?type=do_not_sell']);
const legal = company.filter((l) => LEGAL.has(l.href));
const linkClass = 'inline-block py-1.5 text-stone-700 hover:text-stone-900 hover:underline underline-offset-4';
const head = 'font-semibold text-stone-900';
const track = (target: string) => ({ 'data-track': 'nav_click', 'data-track-placement': 'footer', 'data-track-target': target.split('?')[0] });
---
<footer class="mt-auto border-t border-stone-200 bg-white">
  <div class="shell py-10 text-sm text-stone-600">
    <div class="max-w-xl">
      <a href="/" class="inline-flex items-center gap-2.5 py-1.5 text-stone-900 no-underline" aria-label="RayValue home" {...track('/')}>
        <SunMark size={28} />
        <span class="font-display-tight text-xl">RayValue</span>
      </a>
      <p class="mt-1 text-base text-stone-800">{ui.tagline}</p>
      <p class="mt-2 leading-6">{ui.independent}</p>
    </div>

    {legalOnly ? (
      <nav aria-label="Legal" class="mt-8">
        <ul class="flex flex-wrap gap-x-5">{legal.map((l) => <li><a href={l.href} class={linkClass} {...track(l.href)}>{l.label}</a></li>)}</ul>
      </nav>
    ) : (
      <>
        <nav aria-label={ui.countries} class="mt-8 grid gap-x-8 gap-y-6 border-t border-stone-200 pt-8 lg:grid-cols-[2fr_1.2fr_1fr_1fr]">
          {menu.map((g) => (
            <div>
              <p class={head}>{g.region}</p>
              <ul class="mt-1 flex flex-wrap gap-x-4">
                {g.items.map((c) => <li><a href={c.href} aria-current={c.current ? 'page' : undefined} class={linkClass} {...track(c.href)}>{c.name}</a></li>)}
              </ul>
            </div>
          ))}
        </nav>
        <div class="mt-8 grid gap-8 border-t border-stone-200 pt-8 sm:grid-cols-2 lg:grid-cols-3">
          <nav aria-label="Calculators">
            <p class={head}>{ui.calculators}</p>
            <ul class="mt-1">
              {calculators.map((c) => <li><a href={c.href} class={linkClass} {...track(c.href)}>{c.country === 'United States' ? `${c.label}, United States` : c.country}</a></li>)}
            </ul>
          </nav>
          <nav aria-label="Read">
            <p class={head}>Read</p>
            <ul class="mt-1">
              <li><a href="/guides" class={linkClass} {...track('/guides')}>Guides from every country</a></li>
              <li><a href="/blog" class={linkClass} {...track('/blog')}>Blog from every country</a></li>
              {ctx.kind === 'us' && <li><a href="/stories" class={linkClass} {...track('/stories')}>Real stories</a></li>}
              {ctx.kind === 'us' && <li><a href="/quotes" class={linkClass} {...track('/quotes')}>Get installer quotes</a></li>}
            </ul>
          </nav>
          <nav aria-label={ui.footerCompany}>
            <p class={head}>{ui.footerCompany}</p>
            <ul class="mt-1">
              {company.map((l) => <li><a href={l.href} class={linkClass} {...track(l.href)}>{l.label}</a></li>)}
            </ul>
          </nav>
        </div>
        {showUs && (
          <nav aria-label="Solar payback by state, utility and city" class="mt-8 grid gap-6 border-t border-stone-200 pt-8 sm:grid-cols-2">
            {byState.map((st) => (
              <div>
                <p class={head}><a href={st.calc} class="hover:underline underline-offset-4" {...track(st.calc)}>Solar payback in {st.name}</a></p>
                <p class="mt-2 font-medium text-stone-700">By utility</p>
                <ul class="flex flex-wrap gap-x-4">{st.utilities.map((l) => <li><a href={l.href} class={linkClass} {...track(l.href)}>{l.label}</a></li>)}</ul>
                {st.cities.length > 0 && <p class="mt-2 font-medium text-stone-700">By city</p>}
                <ul class="flex flex-wrap gap-x-4">{st.cities.map((l) => <li><a href={l.href} class={linkClass} {...track(l.href)}>{l.label}</a></li>)}</ul>
              </div>
            ))}
          </nav>
        )}
      </>
    )}
    <p class="mt-8">&copy; {new Date().getFullYear()} RayValue</p>
  </div>
</footer>
