---
const links = [
  { href: '/about', label: 'About' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/affiliate-disclosure', label: 'Affiliate Disclosure' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: '/contact', label: 'Contact' },
];
---
<footer class="mt-auto border-t border-stone-200 bg-white">
  <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-stone-600">
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {links.map((l) => (
          <li><a href={l.href} class="text-stone-700 hover:text-stone-900 hover:underline underline-offset-4">{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="mt-4">RayValue is an independent site, not affiliated with any utility or government agency.</p>
    <p class="mt-1">&copy; {new Date().getFullYear()} RayValue</p>
  </div>
</footer>
