---
import { headerLinks } from '../lib/nav';
import { publishedGuides } from '../lib/guides';
import { publishedPosts } from '../lib/blog';
// Guides/Blog show only once each has >= NAV_MIN_PUBLISHED published items (src/lib/nav.ts).
// Full-bleed header (owner decision): logo pinned to the left gutter, nav to the right gutter at any width.
// Mobile (<640px): nav gets its own single row with short labels; the full name is in `title`.
const links = headerLinks({ guides: (await publishedGuides()).length, blog: (await publishedPosts()).length });
const path = Astro.url.pathname.replace(/\/+$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="border-b border-stone-200 bg-white">
  <div class="flex w-full flex-col gap-1 px-gutter pb-1 pt-4 sm:flex-row sm:items-center sm:justify-between sm:gap-3 sm:py-3">
    <a href="/" class="flex min-h-11 w-fit items-center gap-2.5 text-stone-900 no-underline">
      <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="7" fill="#fbbf24"></circle>
        <g stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round">
          <path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M6.8 25.2l2.8-2.8M22.4 9.6l2.8-2.8"></path>
        </g>
      </svg>
      <span class="flex flex-col leading-tight">
        <span class="text-lg font-bold tracking-tight">RayValue</span>
        <span class="text-xs text-stone-600">Solar math for your home</span>
      </span>
    </a>
    <!-- The ul's 4px padding (offset by the nav's negative margin) keeps focus outlines inside the mobile
         scroll container, which would otherwise clip them. Desktop does not scroll, so nothing clips there. -->
    <nav aria-label="Main" class="-mx-3 -my-1 min-w-0">
      <ul class="scrollbar-none flex flex-nowrap gap-x-1 p-1 text-sm font-medium max-sm:overflow-x-auto sm:gap-x-3">
        {links.map((l) => {
          const current = isCurrent(l.href);
          return (
            <li class="shrink-0">
              <a
                href={l.href}
                title={l.short !== l.label ? l.label : undefined}
                aria-current={current ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center whitespace-nowrap px-2 underline-offset-4 hover:underline',
                  current ? 'font-semibold text-stone-900' : 'text-stone-700 hover:text-stone-900',
                ]}
              >
                {l.short !== l.label ? (
                  <><span class="sm:hidden">{l.short}</span><span class="hidden sm:inline">{l.label}</span></>
                ) : l.label}
              </a>
            </li>
          );
        })}
        <li class="shrink-0">
          <a
            href="/quotes"
            aria-current={isCurrent('/quotes') ? 'page' : undefined}
            class="group ml-1 inline-flex min-h-11 items-center whitespace-nowrap no-underline"
          >
            <span class="rounded-full bg-sun-400 px-3 py-1.5 font-semibold text-stone-900 group-hover:bg-sun-500">Get quotes</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
