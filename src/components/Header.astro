---
import { GLOBAL_NAV, navContext } from '../lib/nav';
import { loadCountryCounts } from '../lib/country-nav-load';
import { uiText } from '../lib/i18n/ui';
import SunMark from './SunMark.astro';
// One global header on every page: sticky pastel glass bar with the logo, Countries / Calculators / Guides / Blog /
// Methodology links and a "Check my payback" button. A second row gives the country context: that country's overview,
// calculator, guides and blog (non-US), or the US overview, state calculators, guides, blog, stories and the US-only
// quote CTA. Global pages have no second row. No JS: the links are plain anchors.
const { logoOnly = false, lang = 'en' } = Astro.props as { logoOnly?: boolean; lang?: string };
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const counts = logoOnly ? new Map() : await loadCountryCounts();
const ctx = navContext({ path, known: [...counts.keys()], counts, lang });
const ui = uiText(lang);
const label = { countries: ui.countries, calculators: ui.calculators, guides: ui.guides, blog: ui.blog, methodology: ui.methodology } as const;
const isCurrent = (href: string) => !href.includes('#') && (path === href || path.startsWith(`${href}/`));
const linkBase = 'inline-flex min-h-11 items-center whitespace-nowrap rounded-lg px-2.5 text-[15px] font-medium text-stone-900 no-underline hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900';
const wrap = 'mx-auto flex w-full max-w-[calc(var(--container-shell)+2*var(--spacing-gutter))] px-gutter';
---
<header class="relative z-30 border-b border-sky-pastel-300 bg-sky-pastel-200/90 text-stone-900 backdrop-blur-sm sm:sticky sm:top-0">
  <div class:list={[wrap, 'flex-wrap items-center gap-x-6 gap-y-0 py-2']}>
    <a href="/" class="flex min-h-11 w-fit items-center gap-2.5 text-stone-900 no-underline" aria-label="RayValue home" data-track="nav_click" data-track-placement="header" data-track-target="/">
      <SunMark size={34} />
      <span class="flex flex-col leading-tight">
        <span class="font-display-tight text-[21px]">RayValue</span>
        <span class="hidden text-xs text-stone-700 sm:block">{ui.tagline}</span>
      </span>
    </a>
    {!logoOnly && (
      <>
        <nav aria-label="Main" class="order-last -mx-1.5 w-full sm:order-none sm:mx-0 sm:w-auto sm:flex-1">
          <ul class="scrollbar-none flex flex-nowrap gap-x-0.5 overflow-x-auto sm:flex-wrap sm:overflow-visible">
            {GLOBAL_NAV.map((l) => (
              <li class="shrink-0">
                <a
                  href={l.href}
                  data-track="nav_click"
                  data-track-placement="header"
                  data-track-target={l.href}
                  aria-current={isCurrent(l.href) ? 'page' : undefined}
                  class:list={[linkBase, isCurrent(l.href) && 'bg-white/70']}
                >{label[l.key]}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a href="/#report" class="ml-auto inline-flex min-h-11 items-center gap-2 rounded-lg bg-sun-400 px-4 font-semibold text-stone-900 no-underline hover:bg-sun-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 sm:ml-0" data-track="nav_click" data-track-placement="header_cta" data-track-target="/#report">Check my payback</a>
      </>
    )}
  </div>
  {!logoOnly && ctx.kind !== 'global' && (
    <div class="border-t border-sky-pastel-300 bg-sky-pastel-50/90">
      <nav aria-label={ctx.name ?? undefined} class:list={[wrap, 'items-center gap-x-1']}>
        <p class="shrink-0 pr-2 text-sm font-semibold text-stone-900">{ctx.name}</p>
        <ul class="scrollbar-none flex min-w-0 flex-1 flex-nowrap gap-x-0.5 overflow-x-auto p-1 text-sm">
          {ctx.links.map((l) => (
            <li class="shrink-0">
              <a
                href={l.href}
                data-track="nav_click"
                data-track-placement="header_context"
                data-track-target={l.href}
                aria-current={path === l.href ? 'page' : undefined}
                class:list={['inline-flex min-h-11 items-center whitespace-nowrap rounded-md px-2.5 underline-offset-4 hover:bg-white hover:text-stone-900', path === l.href ? 'font-semibold text-stone-900 underline decoration-sun-500 decoration-2' : 'text-stone-700']}
              >{l.label}</a>
            </li>
          ))}
        </ul>
        {ctx.cta && (
          <a href={ctx.cta.href} data-track="nav_click" data-track-placement="header_context" data-track-target={ctx.cta.href} class="group ml-1 inline-flex min-h-11 shrink-0 items-center whitespace-nowrap no-underline">
            <span class="rounded-full bg-sun-400 px-3 py-1.5 text-sm font-semibold text-stone-900 group-hover:bg-sun-500">{ctx.cta.label}</span>
          </a>
        )}
      </nav>
    </div>
  )}
</header>
