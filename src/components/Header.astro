---
const links = [
  { href: '/calculator/florida', label: 'Florida calculator' },
  { href: '/calculator/california', label: 'California calculator' },
  { href: '/guides', label: 'Guides' },
  { href: '/blog', label: 'Blog' },
];
---
<header class="border-b border-stone-200 bg-white">
  <div class="flex w-full flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-10">
    <a href="/" class="flex items-center gap-2.5 text-stone-900 no-underline" aria-label="RayValue home">
      <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <circle cx="16" cy="16" r="7" fill="#fbbf24"></circle>
        <g stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round">
          <path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M6.8 25.2l2.8-2.8M22.4 9.6l2.8-2.8"></path>
        </g>
      </svg>
      <span class="flex flex-col leading-tight">
        <span class="text-lg font-bold tracking-tight">RayValue</span>
        <span class="text-xs text-stone-600">Solar math for your home</span>
      </span>
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-medium">
        {links.map((l) => (
          <li><a href={l.href} class="py-1 text-stone-700 hover:text-stone-900 hover:underline underline-offset-4">{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
