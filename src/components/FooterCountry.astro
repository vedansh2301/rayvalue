---
// Footer for non-US pages: this country's links, shared company pages and a country switcher, in the page language.
// No US calculators, no "Get quotes", no US-only privacy wording.
import type { CountryNav } from '../lib/content/country-nav';
import { uiText } from '../lib/i18n/ui';
import { countryName } from '../lib/content/country-nav';
interface Props { nav: CountryNav; lang: string }
const { nav, lang } = Astro.props;
const ui = uiText(lang);
const linkClass = 'inline-block py-1.5 text-stone-700 hover:text-stone-900 hover:underline underline-offset-4';
const columns = [
  { title: countryName(nav.segment, lang), links: [nav.home, ...nav.links] },
  { title: ui.footerCompany, links: [
    { href: '/methodology', label: ui.methodology },
    { href: '/about', label: ui.about },
    { href: '/contact', label: ui.contact },
    { href: '/privacy', label: ui.privacy },
    { href: '/terms', label: ui.terms },
  ] },
];
---
<footer class="mt-auto border-t border-stone-200 bg-white">
  <div class="shell py-10 text-sm text-stone-600">
    <div class="grid gap-8 md:grid-cols-[1.2fr_2fr]">
      <div>
        <a href={nav.home.href} class="inline-flex items-center gap-2.5 py-1.5 text-stone-900 no-underline" aria-label={`RayValue ${nav.home.label}`} data-track="nav_click" data-track-placement="footer" data-track-target={nav.home.href}>
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <circle cx="16" cy="16" r="7" fill="#fbbf24"></circle>
            <g stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round">
              <path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M6.8 25.2l2.8-2.8M22.4 9.6l2.8-2.8"></path>
            </g>
          </svg>
          <span class="text-lg font-bold tracking-tight">RayValue</span>
        </a>
        <p class="mt-2 max-w-sm leading-6">{ui.independent}</p>
      </div>
      <nav aria-label="Footer" class="grid gap-6 sm:grid-cols-2">
        {columns.map((c) => (
          <div>
            <p class="font-semibold text-stone-900">{c.title}</p>
            <ul class="mt-1">
              {c.links.map((l) => <li><a href={l.href} class={linkClass} data-track="nav_click" data-track-placement="footer" data-track-target={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    {nav.switcher.length > 1 && (
      <nav aria-label={ui.switchCountry} class="mt-8 border-t border-stone-200 pt-6">
        <p class="font-semibold text-stone-900">{ui.countries}</p>
        <ul class="flex flex-wrap gap-x-4">
          {nav.switcher.map((c) => <li><a href={c.href} class={linkClass} aria-current={c.current ? 'true' : undefined} data-track="nav_click" data-track-placement="footer" data-track-target={c.href}>{c.label}</a></li>)}
          <li><a href="/" class={linkClass} data-track="nav_click" data-track-placement="footer" data-track-target="/">{countryName('us', lang)}</a></li>
        </ul>
      </nav>
    )}
    <p class="mt-8">&copy; {new Date().getFullYear()} RayValue</p>
  </div>
</footer>
