---
/**
 * The picture slot for a country card: a real photo when one is passed (`image`, an ImageMetadata, e.g. from the licensed
 * image library's getCountryImage helper), otherwise a pastel panel with the country's outline drawn large. The wrapper
 * fills its parent (parent sets the aspect ratio and `relative`). Decorative: the card's text carries the meaning, so
 * the fallback is aria-hidden and a photo needs `alt`.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { COUNTRY_OUTLINES } from '../../lib/brand/country-outlines';

interface Props {
  segment: string;
  image?: ImageMetadata;
  alt?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { segment, image, alt = '', sizes = '(min-width: 1024px) 400px, 100vw', eager = false, class: cls = '' } = Astro.props;
const o = COUNTRY_OUTLINES[segment];
const widths = image ? [400, 640, 960].filter((w) => w <= image.width) : [];
---
{image ? (
  <Picture src={image} alt={alt} formats={['avif', 'webp']} widths={widths.length ? widths : [image.width]} sizes={sizes} width={960} height={Math.round((960 * image.height) / image.width)} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" class:list={['absolute inset-0 h-full w-full object-cover', cls]} />
) : (
  <div class:list={['absolute inset-0 flex items-center justify-center overflow-hidden bg-sky-pastel-100', cls]} aria-hidden="true">
    <svg viewBox="0 0 160 90" class="absolute inset-0 h-full w-full" preserveAspectRatio="xMidYMid slice" fill="none" focusable="false">
      <circle cx="136" cy="14" r="34" fill="#fbbf24" opacity="0.3"></circle>
      <path d="M0 74q40-14 80-4t80-8v28H0z" fill="#ffffff" opacity="0.55"></path>
    </svg>
    {o && (
      <svg viewBox={`0 0 ${o.w} ${o.h}`} class="relative h-[78%] w-auto max-w-[70%] fill-sky-pastel-300 stroke-sky-pastel-600" stroke-width="1.2" stroke-linejoin="round" focusable="false">
        <path d={o.d} vector-effect="non-scaling-stroke"></path>
      </svg>
    )}
  </div>
)}
