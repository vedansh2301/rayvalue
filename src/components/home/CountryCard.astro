---
// Country card for the home picker, in the home-design style: a picture slot (photo when `image` is passed, otherwise a
// pastel panel with the country's outline) with the outline badge and an optional "days left" pill, then the name, local
// name, counts and shortcut chips for the calculator, the nearest deadline guide and the guides index. The picture and
// the name both link to the hub; chips are separate links (no <a> nested in an <a>).
import type { ImageMetadata } from 'astro';
import CountryOutline from '../brand/CountryOutline.astro';
import type { Photo } from '../../lib/images/place-images';
import CountryArt from './CountryArt.astro';
import { cardCounts, type CountryCard } from '../../lib/home/global-home';
interface Chip { label: string; href: string; aria?: string; lang?: string; kind: 'calc' | 'deadline' | 'guides' }
interface Props { card: CountryCard; chips: Chip[]; placement?: string; deadlineDays?: number; image?: ImageMetadata; imageAlt?: string; photo?: Photo | null }
const { card: c, chips, placement = 'home_card', deadlineDays, image, imageAlt, photo } = Astro.props;
const chipBase = 'inline-flex min-h-8 max-w-full items-center rounded-full border px-3 text-sm font-medium no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900';
const chipClass: Record<Chip['kind'], string> = {
  calc: 'border-sun-500 bg-sun-400 text-stone-900 hover:bg-sun-500',
  deadline: 'border-sun-300 bg-sun-50 text-sun-ink hover:border-stone-900 hover:text-stone-900',
  guides: 'border-sky-pastel-400 bg-sky-pastel-50 text-stone-900 hover:border-stone-900',
};
---
<li class="group relative flex flex-col rounded-2xl border border-sky-pastel-300 bg-white transition duration-150 hover:-translate-y-0.5 hover:border-sky-pastel-600 hover:shadow-lift">
  <a href={c.href} class="relative block aspect-[16/10] overflow-hidden rounded-t-2xl bg-sky-pastel-100 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-stone-900" aria-label={`${c.name} overview`} data-track="nav_click" data-track-placement={`${placement}_image`} data-track-target={c.href}>
    <CountryArt segment={c.segment} image={image} photo={photo} alt={imageAlt} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" />
    {deadlineDays !== undefined && <span class="pointer-events-none absolute right-3 top-3 rounded-full bg-sun-400 px-2.5 py-1 text-xs font-bold text-stone-900">{deadlineDays} {deadlineDays === 1 ? 'day' : 'days'} to a deadline</span>}
  </a>
  <div class="relative flex flex-1 flex-col gap-3 px-5 pb-5 pt-[1.125rem]">
    <span class="pointer-events-none absolute -top-[2.375rem] right-3.5 flex size-[4.5rem] items-center justify-center rounded-[18px] border border-sky-pastel-300 bg-white shadow-badge"><CountryOutline segment={c.segment} soft class="h-[50px] w-auto max-w-[50px]" /></span>
    <div class="pr-[4.75rem]">
      <h3 class="font-display-tight text-[1.625rem] leading-tight text-stone-900"><a href={c.href} class="no-underline hover:text-sun-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900" data-track="nav_click" data-track-placement={placement} data-track-target={c.href}>{c.name}</a></h3>
      {c.localName && <p lang={c.localLang ?? undefined} class="text-sm text-stone-700">{c.localName}</p>}
      <p class="mt-1 text-sm text-stone-700">{cardCounts(c)}</p>
    </div>
    <ul class="mt-auto flex flex-wrap gap-2" aria-label={`${c.name} shortcuts`}>
      {chips.map((k) => (
        <li class="min-w-0 max-w-full">
          <a href={k.href} lang={k.lang} aria-label={k.aria} class:list={[chipBase, chipClass[k.kind]]} data-track="nav_click" data-track-placement={`${placement}_chip`} data-track-target={k.href}>
            {k.kind === 'deadline' && <span class="mr-1 shrink-0 font-semibold">Deadline:</span>}
            <span class:list={[k.kind === 'deadline' && 'truncate']}>{k.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</li>
