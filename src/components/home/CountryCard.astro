---
// Country card for the home picker. One primary link (the country hub, stretched over the card with ::after) plus
// separate chip links for the calculator, the nearest deadline guide and the guides index. No <a> is nested in another
// <a>; chips sit above the stretched link (relative z-10).
import CountryOutline from '../brand/CountryOutline.astro';
import { cardCounts, type CountryCard } from '../../lib/home/global-home';
interface Chip { label: string; href: string; aria?: string; lang?: string; kind: 'calc' | 'deadline' | 'guides' }
interface Props { card: CountryCard; chips: Chip[]; placement?: string }
const { card: c, chips, placement = 'home_card' } = Astro.props;
const chipBase = 'relative z-10 inline-flex min-h-8 max-w-full items-center rounded-full border px-3 text-sm font-medium no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900';
const chipClass: Record<Chip['kind'], string> = {
  calc: 'border-sun-500 bg-sun-400 text-stone-900 hover:bg-sun-500',
  deadline: 'border-sun-300 bg-sun-50 text-sun-ink hover:border-sun-500',
  guides: 'border-sky-pastel-400 bg-sky-pastel-50 text-stone-900 hover:border-sky-pastel-600 hover:bg-sky-pastel-100',
};
---
<li class="group relative flex flex-col gap-3 rounded-2xl border border-sky-pastel-300 bg-white p-4 transition duration-150 hover:-translate-y-0.5 hover:border-sky-pastel-600 hover:bg-sky-pastel-50 hover:shadow-md sm:p-5">
  <div class="flex items-center justify-between gap-3">
    <div class="min-w-0">
      <h3 class="font-display-tight text-2xl leading-tight text-stone-900">
        <a href={c.href} class="no-underline after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-stone-900" data-track="nav_click" data-track-placement={placement} data-track-target={c.href}>{c.name}</a>
      </h3>
      {c.localName && <p lang={c.localLang ?? undefined} class="text-sm text-stone-700">{c.localName}</p>}
      <p class="mt-1 text-sm text-stone-700">{cardCounts(c)}</p>
    </div>
    <CountryOutline segment={c.segment} soft class="h-20 w-auto max-w-[40%] shrink-0 transition-transform duration-150 group-hover:scale-105 sm:h-24" />
  </div>
  <ul class="mt-auto flex flex-wrap gap-2" aria-label={`${c.name} shortcuts`}>
    {chips.map((k) => (
      <li class="min-w-0 max-w-full">
        <a href={k.href} lang={k.lang} aria-label={k.aria} class:list={[chipBase, chipClass[k.kind]]} data-track="nav_click" data-track-placement={`${placement}_chip`} data-track-target={k.href}>
          {k.kind === 'deadline' && <span class="mr-1 shrink-0 font-semibold">Deadline:</span>}
          <span class:list={[k.kind === 'deadline' && 'truncate']}>{k.label}</span>
        </a>
      </li>
    ))}
  </ul>
</li>
