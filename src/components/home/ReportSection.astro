---
/**
 * "Know your payback before an installer names a price." The 3-step report flow (ReportFlow island). Installer quotes
 * and consent exist for US homes only; every other country ends at its calculator or guides, never a personal-data form.
 */
import Icon, { type IconName } from '../icons/Icon';
import ReportFlow from './ReportFlow';
import { COUNTRY_OUTLINES } from '../../lib/brand/country-outlines';
import type { Destination } from '../../lib/home/global-home';

interface Props { destinations: Destination[]; quick: string[] }
const { destinations, quick } = Astro.props;
// One entry per country (the US has two calculators; the flow hands US homes to the quote form instead).
const countries = [...new Map(destinations.map((d) => [d.segment, {
  code: d.segment,
  name: d.segment === 'us' ? 'United States' : d.label,
  href: d.href,
  kind: d.kind,
}])).values()].sort((a, b) => a.name.localeCompare(b.name));
const short: Record<string, string> = { us: 'USA', uk: 'UK' };
const quickSegs = quick.map((k) => (k.startsWith('us-') ? 'us' : k)).filter((k, i, a) => a.indexOf(k) === i && countries.some((c) => c.code === k));
const quickPairs: [string, string][] = quickSegs.map((k) => [k, short[k] ?? countries.find((c) => c.code === k)!.name]);
const outlines = Object.fromEntries(quickSegs.filter((k) => COUNTRY_OUTLINES[k]).map((k) => [k, COUNTRY_OUTLINES[k]]));
const steps: { icon: IconName; title: string; body: string }[] = [
  { icon: 'home', title: 'Tell us about your home', body: 'Country, bill and what you\u2019re deciding on' },
  { icon: 'chart', title: 'Get low, likely and high ranges', body: 'Every assumption and source listed' },
  { icon: 'users', title: 'Compare up to 3 real quotes (US homes)', body: 'Optional. Shared only with installers you choose' },
];
---
<section id="report" class="scroll-mt-16 bg-gradient-to-b from-sky-pastel-200 to-sky-pastel-100" aria-labelledby="report-title" data-report>
  <div class="shell grid items-start gap-x-[clamp(2rem,5vw,4rem)] gap-y-10 py-[clamp(3rem,6vw,5.5rem)] lg:grid-cols-2">
    <div class="flex flex-col gap-5">
      <h2 id="report-title" class="font-display-tight text-[clamp(2rem,4vw,3.125rem)] leading-[1.08] text-stone-900">Know your payback before an installer names a price.</h2>
      <p class="max-w-[44ch] text-lg leading-relaxed text-stone-800">Three quick questions. You get a payback report built from your country&rsquo;s official rates, and, for US homes, you can also ask for up to 3 quotes from local installers to check against it.</p>
      <ol class="flex flex-col gap-3.5">
        {steps.map((s) => (
          <li class="flex items-center gap-3.5">
            <span class="flex size-12 flex-none items-center justify-center rounded-[14px] bg-white text-stone-900"><Icon name={s.icon} size={24} /></span>
            <span><strong class="text-stone-900">{s.title}</strong><br /><span class="text-[15px] text-stone-700">{s.body}</span></span>
          </li>
        ))}
      </ol>
    </div>

    <ReportFlow client:visible countries={countries} quick={quickPairs} outlines={outlines} initial="us" />
  </div>
</section>
