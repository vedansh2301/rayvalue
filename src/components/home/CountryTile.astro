---
// "All countries" tile (design: RayValue Home v2): outline on its own (no icon square), name in bold, then
// "local name · N pages". No region text; the list is one alphabetical run.
import CountryOutline from '../brand/CountryOutline.astro';
import { cardWeight, type CountryCard } from '../../lib/home/global-home';
interface Props { card: CountryCard; placement?: string }
const { card: c, placement = 'home_more' } = Astro.props;
const sub = `${c.localName ? `${c.localName} · ` : ''}${cardWeight(c)} pages`;
---
<li>
  <a href={c.href} class="group flex items-center gap-3 rounded-xl border border-sky-pastel-300 bg-white px-3 py-2.5 text-stone-900 no-underline transition duration-150 hover:border-sky-pastel-600 hover:bg-sky-pastel-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900" data-track="nav_click" data-track-placement={placement} data-track-target={c.href}>
    <CountryOutline segment={c.segment} soft class="size-[34px] flex-none [&_path]:[vector-effect:non-scaling-stroke]" />
    <span class="flex min-w-0 flex-col">
      <strong class="text-[15px] font-semibold">{c.name}</strong>
      <span class="text-xs text-stone-700">{sub}</span>
    </span>
  </a>
</li>
