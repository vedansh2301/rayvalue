---
import type { State } from '../data/schemas';

interface Props {
  state: State;
}
const { state } = Astro.props;
const stateName = state === 'FL' ? 'Florida' : 'California';
---
<section id="alerts" aria-labelledby="alerts-heading" class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-8">
  <h2 id="alerts-heading" class="text-xl font-semibold text-stone-900">Get rate change alerts</h2>
  <p class="mt-2 leading-7 text-stone-700">
    Utility rates and solar rules in {stateName} change. We&rsquo;ll email you when something changes that affects your payback. No spam, unsubscribe any time.
  </p>
  <form method="post" action="/api/subscribe" class="relative mt-4 flex flex-col gap-3 sm:flex-row sm:items-end">
    <div class="flex-1">
      <label for="alerts-email" class="block font-medium text-stone-900">Email address</label>
      <input
        id="alerts-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        class="mt-2 block min-h-11 w-full rounded-lg border border-stone-400 bg-white px-3 py-2 text-stone-900"
      />
    </div>
    <input type="hidden" name="state" value={state} />
    <div class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
      <label for="alerts-website">Leave this field empty</label>
      <input id="alerts-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-sun-400 px-5 py-2.5 font-semibold text-stone-900 hover:bg-sun-500">
      Sign up
    </button>
  </form>
  <p class="mt-3 text-sm text-stone-600">
    We only use your email for these alerts. See our <a href="/privacy" class="text-sun-ink underline underline-offset-2 hover:text-stone-900">privacy policy</a>.
  </p>
</section>
