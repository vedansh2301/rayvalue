---
/**
 * Ad landing page: logo-only header, the calculator right under a one-line headline, trust strip, short FAQ,
 * legal-only footer. noindex (and out of the sitemap). ?utility= preselects the utility (handled by the island).
 * Conversion tags: the env-gated adapter (src/lib/ads) forwards calc_complete / quote_submit when, and only when,
 * the owner sets PUBLIC_GOOGLE_ADS_ID / PUBLIC_META_PIXEL_ID. Vercel Analytics events always fire.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Calculator from '../calculator/Calculator';
import Faq from '../Faq.astro';
import type { CalculatorPageData } from '../../lib/calculator/page-data';
import type { GoPage } from '../../lib/go';
import { GO_FAQ_IDS, GO_TRUST } from '../../lib/go';
import { faqItems } from '../../lib/content/faq';

interface Props {
  page: GoPage;
  data: CalculatorPageData;
}
const { page, data } = Astro.props;
const faq = faqItems(GO_FAQ_IDS);
---
<BaseLayout
  title={`${page.stateName} solar payback calculator`}
  description={`Estimate solar and battery cost, savings and payback for your ${page.stateName} home, as honest ranges with no federal tax credit.`}
  path={page.path}
  noindex
  minimal
>
  <div class="shell pb-20 pt-5 sm:pt-8">
    <div class="max-w-(--container-prose)">
      <h1 class="text-2xl font-bold tracking-tight text-stone-900 sm:text-4xl">Is solar worth it for your {page.stateName} home?</h1>
      <p class="mt-2 text-stone-700">Four quick questions. Low, likely and high ranges from your utility&rsquo;s published rates.</p>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium text-stone-800" aria-label="Why use RayValue">
        {GO_TRUST.map((t) => (
          <li class="flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="shrink-0 text-sun-ink">
              <path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            {t}
          </li>
        ))}
      </ul>

      <section aria-label="Calculator" class="mt-5">
        {data.ok ? (
          <Calculator client:load {...data.props} alertsEnabled={false} />
        ) : (
          <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-8">
            <h2 class="text-xl font-semibold text-stone-900">We&rsquo;re verifying rates for this state</h2>
            <p class="mt-2 leading-7 text-stone-700">The {page.stateName} calculator is temporarily unavailable while we check our rate data.</p>
          </div>
        )}
      </section>

      <div class="mt-12">
        <Faq items={faq} id="go-faq" />
      </div>
    </div>
  </div>
</BaseLayout>
