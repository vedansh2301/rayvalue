---
/**
 * Ray, the RayValue mascot: a friendly geometric sun. Original artwork, pure inline SVG with presentation attributes
 * only (hashed CSP: no style=). Reads on light and on ink backgrounds because the face is solid sun yellow.
 * Poses: mark (face only, for the logo), wave (hero), point (calculators), calendar (deadlines),
 * magnifier (methodology and sources), confused (404 and empty states).
 */
import type { RayPose } from '../../lib/brand/ray';
interface Props { pose?: RayPose; size?: number; class?: string; label?: string }
const { pose = 'wave', size = 160, class: cls, label } = Astro.props;

const INK = '#1c1917';
const SUN = '#fbbf24';
const EDGE = '#f59e0b';
// 12 short rays around the face, computed once.
const rays = Array.from({ length: 12 }, (_, i) => {
  const a = (i * Math.PI) / 6;
  const [c, s] = [Math.cos(a), Math.sin(a)];
  return `M${(70 + c * 43).toFixed(1)} ${(60 + s * 43).toFixed(1)}L${(70 + c * 53).toFixed(1)} ${(60 + s * 53).toFixed(1)}`;
}).join('');
const mark = pose === 'mark';
const tilt = pose === 'confused' ? 'rotate(-7 70 60)' : undefined;
---
<svg
  viewBox={mark ? '15 5 110 110' : '0 0 140 120'}
  width={size}
  height={mark ? size : Math.round(size * 120 / 140)}
  class={cls}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <g transform={tilt}>
    <path d={rays} stroke={EDGE} stroke-width="6" stroke-linecap="round" fill="none"></path>
    <circle cx="70" cy="60" r="34" fill={SUN} stroke={EDGE} stroke-width="3"></circle>
    <circle cx="52" cy="68" r="5.5" fill="#fb923c" opacity="0.45"></circle>
    <circle cx="88" cy="68" r="5.5" fill="#fb923c" opacity="0.45"></circle>
    {pose === 'confused' ? (
      <>
        <circle cx="58" cy="57" r="4" fill={INK}></circle>
        <circle cx="82" cy="57" r="4" fill={INK}></circle>
        <path d="M51 47l12-3M77 43l12 4" stroke={INK} stroke-width="3" stroke-linecap="round" fill="none"></path>
        <path d="M58 76q4-5 8 0t8 0t8 0" stroke={INK} stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
      </>
    ) : pose === 'magnifier' ? (
      <>
        <circle cx="58" cy="57" r="4" fill={INK}></circle>
        <circle cx="82" cy="57" r="5.5" fill="#fff" stroke={INK} stroke-width="2.5"></circle>
        <circle cx="83" cy="57" r="2.6" fill={INK}></circle>
        <path d="M58 72q12 8 24 0" stroke={INK} stroke-width="3.2" stroke-linecap="round" fill="none"></path>
      </>
    ) : (
      <>
        <circle cx="58" cy="57" r="4" fill={INK}></circle>
        <circle cx="82" cy="57" r="4" fill={INK}></circle>
        {pose === 'point' ? (
          <path d="M57 72q15 9 27-2" stroke={INK} stroke-width="3.2" stroke-linecap="round" fill="none"></path>
        ) : (
          <path d="M56 70q14 14 28 0z" fill={INK} stroke={INK} stroke-width="2.5" stroke-linejoin="round"></path>
        )}
      </>
    )}
  </g>

  {pose === 'wave' && (
    <>
      <path d="M103 72q16-4 15-26" stroke={EDGE} stroke-width="7" stroke-linecap="round" fill="none"></path>
      <circle cx="117" cy="40" r="8" fill={SUN} stroke={EDGE} stroke-width="3"></circle>
      <path d="M128 30q4 6 1 13M131 24q7 8 2 19" stroke={EDGE} stroke-width="2.5" stroke-linecap="round" fill="none"></path>
      <path d="M37 76q-14 6-18 18" stroke={EDGE} stroke-width="7" stroke-linecap="round" fill="none"></path>
      <circle cx="18" cy="97" r="8" fill={SUN} stroke={EDGE} stroke-width="3"></circle>
    </>
  )}
  {pose === 'point' && (
    <>
      <path d="M103 74l24 6" stroke={EDGE} stroke-width="7" stroke-linecap="round" fill="none"></path>
      <circle cx="131" cy="81" r="7" fill={SUN} stroke={EDGE} stroke-width="3"></circle>
      <path d="M37 76q-14 6-18 18" stroke={EDGE} stroke-width="7" stroke-linecap="round" fill="none"></path>
      <circle cx="18" cy="97" r="8" fill={SUN} stroke={EDGE} stroke-width="3"></circle>
      <g fill="none" stroke={EDGE} stroke-width="3" stroke-linecap="round">
        <path d="M116 96h18M116 106h12"></path>
      </g>
    </>
  )}
  {pose === 'calendar' && (
    <>
      <rect x="88" y="70" width="46" height="42" rx="6" fill="#fff" stroke={INK} stroke-width="3"></rect>
      <path d="M88 84h46" stroke={INK} stroke-width="3"></path>
      <rect x="88" y="70" width="46" height="14" rx="6" fill="#f97316" stroke={INK} stroke-width="3"></rect>
      <path d="M99 66v8M123 66v8" stroke={INK} stroke-width="3.5" stroke-linecap="round"></path>
      <circle cx="100" cy="97" r="3.3" fill={INK}></circle>
      <circle cx="111" cy="97" r="3.3" fill={INK}></circle>
      <circle cx="122" cy="97" r="3.3" fill="#f97316"></circle>
      <path d="M100 104h10" stroke={INK} stroke-width="3" stroke-linecap="round"></path>
      <circle cx="90" cy="104" r="7" fill={SUN} stroke={EDGE} stroke-width="3"></circle>
      <circle cx="132" cy="104" r="7" fill={SUN} stroke={EDGE} stroke-width="3"></circle>
    </>
  )}
  {pose === 'magnifier' && (
    <>
      <path d="M103 80l12 2" stroke={EDGE} stroke-width="7" stroke-linecap="round" fill="none"></path>
      <path d="M118 86l-14 14" stroke={INK} stroke-width="5" stroke-linecap="round"></path>
      <circle cx="120" cy="64" r="17" fill="#fff" fill-opacity="0.55" stroke={INK} stroke-width="4"></circle>
      <path d="M111 60q4-6 10-6" stroke="#fff" stroke-width="3" stroke-linecap="round" fill="none"></path>
      <circle cx="116" cy="86" r="7" fill={SUN} stroke={EDGE} stroke-width="3"></circle>
    </>
  )}
  {pose === 'confused' && (
    <>
      <path d="M112 36q0-14 13-14t13 12q0 8-9 11v6" stroke={INK} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none"></path>
      <circle cx="129" cy="62" r="3.4" fill={INK}></circle>
      <path d="M36 76q-12 6-16 16" stroke={EDGE} stroke-width="7" stroke-linecap="round" fill="none"></path>
      <circle cx="18" cy="96" r="8" fill={SUN} stroke={EDGE} stroke-width="3"></circle>
    </>
  )}
</svg>
