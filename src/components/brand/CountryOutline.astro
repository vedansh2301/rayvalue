---
// A country's outline (Natural Earth 1:110m, public domain, simplified; see scripts/gen-country-outlines.mjs).
// Decorative: the country name sits next to it. Colour comes from the classes (default: currentColor fill and stroke);
// `soft` gives a pastel fill with a darker pastel stroke so the shape reads as a soft illustration, not a flat blob.
import { COUNTRY_OUTLINES } from '../../lib/brand/country-outlines';
interface Props { segment: string; class?: string; soft?: boolean }
const { segment, class: cls, soft = false } = Astro.props;
const o = COUNTRY_OUTLINES[segment];
---
{o && (
  <svg viewBox={`0 0 ${o.w} ${o.h}`} class:list={[cls, soft && 'fill-sky-pastel-200 stroke-sky-pastel-600']} fill="currentColor" stroke="currentColor" stroke-width={soft ? 1.2 : 0.8} stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d={o.d}></path>
  </svg>
)}
