---
// Shared hero band for every top-level page template: pastel sky, a display-serif headline and, optionally, a picture
// beside the text. Slots: `crumbs` (breadcrumbs), default (intro paragraph and extras), `actions` (buttons), `below`
// (full-width row under the actions) and `aside` (a picture beside the text from the lg breakpoint).
interface Props { title: string; size?: 'lg' | 'md'; titleId?: string }
const { title, size = 'md', titleId } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<section class="relative isolate overflow-hidden border-b border-sky-pastel-300 bg-gradient-to-b from-sky-pastel-200 to-sky-pastel-100 text-stone-900" aria-labelledby={titleId}>
  <div class:list={['shell relative', size === 'lg' ? 'pb-12 pt-10 sm:pb-16 sm:pt-14' : 'pb-9 pt-7 sm:pb-12 sm:pt-9']}>
    <div class:list={[hasAside && 'grid items-center gap-8 lg:grid-cols-[3fr_2fr]']}>
      <div>
        <slot name="crumbs" />
        <h1 id={titleId} class:list={['font-display-tight mt-4 max-w-3xl text-balance text-stone-900', size === 'lg' ? 'text-4xl leading-[1.08] sm:text-6xl' : 'text-3xl leading-tight sm:text-5xl']}>{title}</h1>
        <div class="mt-4 max-w-2xl text-lg leading-8 text-stone-800"><slot /></div>
        <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:flex-wrap"><slot name="actions" /></div>
      </div>
      {hasAside && <div class="mx-auto w-full max-w-md lg:max-w-none"><slot name="aside" /></div>}
    </div>
    <slot name="below" />
  </div>
</section>
