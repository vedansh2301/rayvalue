  </defs>
  <circle cx="200" cy="200" r="190" fill="url(#sunglow)"></circle>
  <g fill="none" stroke="#2c4a73" stroke-width="1.25">
    <circle cx="200" cy="200" r="70"></circle>
    <circle cx="200" cy="200" r="105"></circle>
    <circle cx="200" cy="200" r="142"></circle>
    <circle cx="200" cy="200" r="182"></circle>
