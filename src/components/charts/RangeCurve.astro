---
/**
 * Low / likely / high range drawn as a bell curve (EnergySage-style). The curve shape and the thirds are
 * illustrative, not a measured distribution; the three values are the engine's estimates and are shown as text,
 * so the figure reads the same without the drawing. Presentational only: no math beyond what the caller passes.
 */
interface Props {
  title: string;
  low: string;
  likely: string;
  high: string;
  /** Labels for the three zones (defaults suit a price). */
  labels?: [string, string, string];
  /** Suffixes for the outer values, e.g. ['or less', 'or more']. */
  ends?: [string, string];
  caption?: string;
  id: string;
}
const { title, low, likely, high, labels = ['Lower end', 'Likely', 'Higher end'], ends = ['or less', 'or more'], caption, id } = Astro.props;

// Smooth bell from x=60 to x=580 on a 640×150 canvas, peak at the centre; dividers at the thirds.
const pts: string[] = [];
for (let i = 0; i <= 64; i++) {
  const x = 60 + (520 * i) / 64;
  const z = (x - 320) / 95;
  pts.push(`${x.toFixed(1)} ${(140 - 118 * Math.exp(-0.5 * z * z)).toFixed(1)}`);
}
const curve = `M${pts.join(' L')}`;
const area = `${curve} L580 140 L60 140 Z`;
---
<figure aria-labelledby={`${id}-t`} class="not-prose rounded-2xl border border-stone-200 bg-white p-5 sm:p-6">
  <figcaption id={`${id}-t`} class="text-lg font-semibold text-stone-900">{title}</figcaption>
  <div class="relative mt-3">
    <svg viewBox="0 0 640 150" class="h-auto w-full" aria-hidden="true" focusable="false">
      <path d={area} class="fill-sun-100"></path>
      <path d="M213 140 V14 M427 140 V14" class="stroke-stone-300" stroke-width="2" fill="none"></path>
      <path d={curve} class="stroke-stone-900" stroke-width="2.5" fill="none" stroke-linecap="round"></path>
      <path d="M20 140 H620" class="stroke-stone-400" stroke-width="2"></path>
    </svg>
  </div>
  <dl class="mt-3 grid grid-cols-3 gap-2 text-center">
    <div>
      <dt class="text-xs font-medium text-stone-600 sm:text-sm">{labels[0]}</dt>
      <dd class="mt-1 text-sm font-semibold text-stone-900 sm:text-base">{low} <span class="block text-xs font-normal text-stone-600 sm:inline">{ends[0]}</span></dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-stone-600 sm:text-sm">{labels[1]}</dt>
      <dd class="mt-1 text-xl font-bold tracking-tight text-stone-900 sm:text-2xl">{likely}</dd>
    </div>
    <div>
      <dt class="text-xs font-medium text-stone-600 sm:text-sm">{labels[2]}</dt>
      <dd class="mt-1 text-sm font-semibold text-stone-900 sm:text-base">{high} <span class="block text-xs font-normal text-stone-600 sm:inline">{ends[1]}</span></dd>
    </div>
  </dl>
  {caption && <p class="mt-3 text-xs leading-5 text-stone-600">{caption}</p>}
</figure>
