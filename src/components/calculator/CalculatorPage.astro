---
/**
 * Shared calculator page for one state. The page (rendered on demand) loads config, cities and
 * precomputed production from the database via src/lib/calculator/page-data.ts; they are
 * passed to the island as props. If the data cannot be loaded or is invalid, the page still renders
 * (HTTP 200) with a "verifying rates" message and a short CDN cache.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlertsSignup from '../AlertsSignup.astro';
import Disclosure from '../Disclosure.astro';
import OfferCTA from '../OfferCTA.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import FlBatteryNotes from '../FlBatteryNotes.astro';
import StoryCards from '../stories/StoryCards.astro';
import UtilityLinks from '../utility/UtilityLinks.astro';
import Calculator from './Calculator';
import type { State } from '../../data/schemas';
import type { CalculatorPageData } from '../../lib/calculator/page-data';
import { CALCULATOR_PATHS, STATE_NAMES } from '../../lib/calculator/form';
import { PAGE_META } from '../../lib/seo/page-meta';
import { ogImagePath } from '../../lib/seo/og';
import { webApplicationJsonLd } from '../../lib/seo/jsonld';
import { ALERTS_ENABLED } from '../../lib/contact';
import { btnPrimary } from '../ui/buttons';
import { Picture } from 'astro:assets';
import Icon, { type IconName } from '../icons/Icon';
import flPhoto from '../../assets/photos/covers/is-solar-worth-it-without-tax-credit.jpg';
import caPhoto from '../../assets/photos/covers/california-nem-3-batteries.jpg';

interface Props {
  state: State;
  /** Loaded by the page (which also sets the cache headers: they must be set before streaming starts). */
  data: CalculatorPageData;
}
const { state, data } = Astro.props;
const name = STATE_NAMES[state];
const otherState: State = state === 'FL' ? 'CA' : 'FL';

const meta = PAGE_META[state === 'FL' ? 'calculator-florida' : 'calculator-california'];
const offer = data.ok ? data.offer : null;
const photo = state === 'FL'
  ? { src: flPhoto, alt: 'Suburban house with rooftop solar panels, a landscaped garden and a wide lawn on a sunny day' }
  : { src: caPhoto, alt: 'House with dark rooftop solar panels in San Pasqual, Los Angeles County, California' };
const introSteps: { icon: IconName; text: string }[] = [
  { icon: 'home', text: 'Enter your ZIP and utility' },
  { icon: 'bill', text: 'Add your monthly bill' },
  { icon: 'chart', text: 'See your payback range' },
];
const introTrust: { icon: IconName; text: string }[] = [
  { icon: 'check', text: 'Free, no sign-up' },
  { icon: 'scale', text: `${name} utility rates, every assumption listed` },
  { icon: 'shield', text: 'No federal tax credit assumed' },
];
const steps = [
  'We place your ZIP code on the map and look up how much sun a rooftop solar array gets there using the PVWatts solar model, adjusted for the shade you picked.',
  'We work backwards from your bill through your utility’s published rates to estimate how much electricity you use in a year.',
  'We size a system to cover most of that usage and price it with a range of local installed costs.',
  `We apply ${name}’s rules for solar you send back to the grid, then project savings with a range of rate increases.`,
  'We show low, likely and high results, with every assumption listed. No federal tax credit is applied.',
];
---
<BaseLayout
  title={meta.title}
  description={meta.description}
  path={CALCULATOR_PATHS[state]}
  ogImagePath={ogImagePath(state === 'FL' ? 'calculator-florida' : 'calculator-california')}
  jsonLd={[webApplicationJsonLd(state)]}
>
  <div class="shell pt-8 sm:pt-10">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: `${name} calculator` }]} />
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:mt-6 sm:text-4xl">{name} solar payback calculator</h1>
    <p class="mt-2 text-lg text-stone-700">Four quick questions. Low, likely and high ranges from your utility&rsquo;s rates. No federal tax credit assumed.</p>
    <p class="mt-1 text-sm text-stone-700">
      In {STATE_NAMES[otherState]}? Use the <a href={CALCULATOR_PATHS[otherState]} class="text-sun-ink underline underline-offset-2 hover:text-stone-900">{STATE_NAMES[otherState]} calculator</a>.
    </p>
  </div>

  <div class="shell pb-24 pt-6 sm:pb-16">
  <div class="space-y-10">
    <section aria-label="Calculator">
      {data.ok ? (
        <Calculator client:visible {...data.props} alertsEnabled={ALERTS_ENABLED}>
          <div class="hidden lg:block">
            <Picture
              src={photo.src}
              formats={['avif', 'webp']}
              widths={[400, 640]}
              sizes="360px"
              alt={photo.alt}
              width={640}
              height={480}
              loading="eager"
              decoding="async"
              class="aspect-[4/3] w-full rounded-xl object-cover"
            />
          </div>
          <ol class="grid grid-cols-3 gap-2 lg:mt-6 lg:grid-cols-1 lg:gap-4">
            {introSteps.map((st, i) => (
              <li class="flex flex-col items-center gap-2 rounded-xl border border-stone-200 bg-white p-3 text-center lg:flex-row lg:gap-4 lg:p-4 lg:text-left">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sun-100 text-stone-900"><Icon name={st.icon} /></span>
                <span class="text-sm font-medium leading-5 text-stone-900 lg:text-base"><span class="sr-only">Step {i + 1}: </span><span class="hidden lg:inline">{i + 1}. </span>{st.text}</span>
              </li>
            ))}
          </ol>
          <ul class="mt-4 space-y-2 text-sm text-stone-800" aria-label="Why use this calculator">
            {introTrust.map((t) => (
              <li class="flex items-center gap-2"><Icon name={t.icon} size={20} class="text-stone-900" />{t.text}</li>
            ))}
          </ul>
        </Calculator>
      ) : (
        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-8">
          <h2 class="text-xl font-semibold text-stone-900">We&rsquo;re verifying rates for this state</h2>
          <p class="mt-2 leading-7 text-stone-700">
            The {name} calculator is temporarily unavailable while we check our rate data.{ALERTS_ENABLED && <> Sign up below and we&rsquo;ll let you know when rates change.</>}
          </p>
          <p class="mt-4"><a href={`/quotes?state=${state}`} class={btnPrimary}>Get free installer quotes</a></p>
          <p class="mt-2 text-sm text-stone-700">Installers can still quote your home while we finish checking rates. Free, no obligation.</p>
        </div>
      )}
    </section>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="max-w-(--container-prose) space-y-10">
    {offer && (
      <section aria-label="Partner offer" class="space-y-3">
        <Disclosure />
        <OfferCTA offer={offer} state={state} />
      </section>
    )}

    {state === 'FL' && <FlBatteryNotes />}

    <section aria-labelledby="how-heading">
      <h2 id="how-heading" class="text-xl font-semibold text-stone-900">How we calculated this</h2>
      <ol class="mt-4 list-decimal space-y-2 pl-6 leading-7 text-stone-700">
        {steps.map((s) => <li>{s}</li>)}
      </ol>
      <p class="mt-4 text-stone-700">
        Every source and assumption is explained in our <a href="/methodology" class="text-sun-ink underline underline-offset-2 hover:text-stone-900">methodology</a>. Estimates are not a quote; installer prices and your actual usage will differ.
      </p>
    </section>

    {ALERTS_ENABLED && <AlertsSignup state={state} />}
    </div>

    <aside aria-label={`More for ${name} homeowners`} class="flex flex-col gap-5 lg:sticky lg:top-6 lg:self-start">
      <div class="rounded-xl border border-stone-200 bg-white p-5">
        <UtilityLinks state={state} heading={`Solar payback by ${name} utility`} />
      </div>
      <div class="rounded-xl border border-sun-300 bg-sun-50 p-5">
        <h2 class="text-lg font-semibold text-stone-900">Compare real installer prices</h2>
        <p class="mt-2 leading-7 text-stone-700">Estimates show a range. Quotes from {name} installers show what your roof would actually cost. Free, no obligation.</p>
        <a href={`/quotes?state=${state}`} class={`mt-4 w-full justify-center ${btnPrimary}`}>Get installer quotes<span aria-hidden="true">&rarr;</span></a>
      </div>
    </aside>
    </div>

    <section aria-labelledby="stories-heading">
      <h2 id="stories-heading" class="text-xl font-semibold text-stone-900">Real stories from {name}</h2>
      <p class="mb-4 mt-2 text-stone-700">Publicly reported accounts, with links to the original reporting. <a href="/stories" class="text-sun-ink underline underline-offset-2 hover:text-stone-900">See all stories</a>.</p>
      <StoryCards state={state} limit={3} />
    </section>
  </div>
  </div>
</BaseLayout>
