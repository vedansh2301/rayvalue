---
/**
 * Page shell of the country calculators (UK, Germany, Australia) in the Claude Design layout: hero with the live
 * deadline chip, checklist and photo collage; the calculator island (default slot); the "how we calculated this" steps
 * (slot "how"); and real articles to read before buying. Every figure shown here comes from the props the page passes
 * (database rows) or from article frontmatter. No installer quotes are offered outside the US: the next step is the
 * country's guides.
 */
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import rooftop from '../../assets/photos/ca-rooftop-solar-install.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlacePhoto from '../ui/PlacePhoto.astro';
import Cover from '../content/Cover.astro';
import CountryOutline from '../brand/CountryOutline.astro';
import { allPhotos, getArticleImage } from '../../lib/images/place-images';
import { articlePath } from '../../lib/content/paths';
import { blogTopic, BLOG_TOPIC_LABEL } from '../../lib/content/blog-index';
import { guideTopic, GUIDE_TOPIC_LABEL } from '../../lib/content/guides-index';
import { coverTopic } from '../../lib/content/cards';
import { articleSlug } from '../../lib/content/paths';

interface Pick { collection: 'guides' | 'blog'; id: string }
interface Props {
  seg: 'uk' | 'de' | 'au';
  lang: string;
  path: string;
  metaTitle: string;
  metaDescription: string;
  noindex: boolean;
  h1: string;
  sub: string;
  startLabel: string;
  chip: { label: string; href: string } | null;
  checks: string[];
  heroPhotoId: string;
  badge: { title: string; sub: string } | null;
  /** Texts of the section below the calculator. */
  howHeading: string;
  readsHeading: string;
  readsAll: { href: string; label: string };
  readLabel: string;
  picks: Pick[];
  /** Alt text of the rooftop photo, in the page language. */
  rooftopAlt?: string;
}
const { seg, lang, path, metaTitle, metaDescription, noindex, h1, sub, startLabel, chip, checks, heroPhotoId, badge, howHeading, readsHeading, readsAll, readLabel, picks, rooftopAlt = 'Installers lifting a solar panel into place on a shingle roof' } = Astro.props;
const heroPhoto = allPhotos.find((p) => p.id === heroPhotoId) ?? null;
const [guides, posts] = await Promise.all([getCollection('guides', (e) => !e.data.draft && !e.data.noindex), getCollection('blog', (e) => !e.data.draft && !e.data.noindex)]);
const reads = picks.flatMap((p) => {
  const e = (p.collection === 'guides' ? guides : posts).find((x) => x.id === p.id);
  if (!e) return [];
  const d = e.data as { title: string; country: string; lang: string; tags?: string[]; state?: 'FL' | 'CA' | 'both'; cover?: ImageMetadata; coverAlt?: string; route?: string; deadline?: Date };
  const img = getArticleImage({ id: e.id, data: { country: d.country, state: d.state, cover: d.cover, coverAlt: d.coverAlt } });
  const tag = p.collection === 'blog' ? BLOG_TOPIC_LABEL[blogTopic({ id: e.id, title: d.title, tags: d.tags, deadline: d.deadline })] : GUIDE_TOPIC_LABEL[guideTopic({ slug: articleSlug(e.id, d.country), title: d.title })];
  return [{ href: articlePath(p.collection, e.id, d.route, d.country), title: d.title, lang: d.lang, tag, cover: d.cover, photo: d.cover ? null : img?.photo ?? null, topic: coverTopic({ tags: d.tags, title: d.title, state: d.state }), sun: !!d.deadline || /deadline|rules/i.test(tag) }];
});
---
<BaseLayout title={metaTitle} description={metaDescription} path={path} noindex={noindex} lang={lang}>
  <section class="relative isolate overflow-hidden border-b border-sky-pastel-300 bg-gradient-to-b from-sky-pastel-200 via-sky-pastel-100 to-sky-pastel-50" aria-labelledby="calc-title">
    <svg viewBox="0 0 400 400" class="pointer-events-none absolute -right-28 -top-40 -z-10 size-[30rem] opacity-50 motion-safe:animate-sun-slower" aria-hidden="true" focusable="false">
      <circle cx="200" cy="200" r="70" fill="#fcd34d"></circle>
      <g stroke="#fbbf24" stroke-width="10" stroke-linecap="round"><path d="M200 40v50M200 310v50M40 200h50M310 200h50M87 87l35 35M278 278l35 35M87 313l35-35M278 122l35-35"></path></g>
    </svg>
    <div class="shell grid items-center gap-10 py-[clamp(2rem,5vw,4rem)] lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
      <div class="flex flex-col gap-5">
        <h1 id="calc-title" class="font-display-tight text-balance text-[clamp(2.25rem,4.8vw,3.625rem)] leading-[1.06] text-stone-900">{h1}</h1>
        <p class="max-w-[52ch] text-lg leading-relaxed text-stone-800">{sub}</p>
        <div class="flex flex-wrap items-center gap-3">
          <a href="#calc" class="inline-flex min-h-[3.25rem] items-center rounded-[10px] bg-sun-400 px-6 text-[17px] font-bold text-stone-900 no-underline hover:bg-sun-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900">{startLabel} <span aria-hidden="true" class="ml-1.5">&darr;</span></a>
          {chip && <a href={chip.href} class="inline-flex min-h-11 items-center gap-2 rounded-full border border-sun-300 bg-sun-100 px-4 text-sm font-bold text-sun-ink no-underline hover:bg-sun-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900" data-track="nav_click" data-track-placement={`${seg}_calc_hero`} data-track-target={chip.href}>{chip.label}</a>}
        </div>
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-stone-800">
          {checks.map((c) => <li class="flex items-center gap-1.5"><svg viewBox="0 0 24 24" class="size-4 flex-none" fill="none" stroke="#1c1917" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>{c}</li>)}
        </ul>
      </div>
      <div class="relative mx-auto grid w-full max-w-xl grid-cols-[1.15fr_0.85fr] items-end gap-3">
        <div class="relative aspect-[4/5] overflow-hidden rounded-[22px] bg-sky-pastel-100 shadow-[0_26px_50px_-26px_rgba(28,25,23,0.45)]">
          {heroPhoto && <PlacePhoto photo={heroPhoto} sizes="(min-width: 1024px) 280px, 50vw" credit="text" creditAt="top-right" eager />}
        </div>
        <div class="relative mb-8 aspect-square overflow-hidden rounded-[22px] bg-sky-pastel-100 shadow-[0_26px_50px_-26px_rgba(28,25,23,0.45)]">
          <Picture src={rooftop} alt={rooftopAlt} formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="(min-width: 1024px) 220px, 40vw" width={640} height={480} loading="eager" class="absolute inset-0 h-full w-full object-cover" />
        </div>
        {badge && (
          <div class="absolute -bottom-3 left-[34%] flex items-center gap-3 rounded-2xl bg-white p-3 pr-4 shadow-[0_18px_40px_-20px_rgba(28,25,23,0.5)] motion-safe:animate-float">
            <CountryOutline segment={seg} class="size-10 fill-sun-400 stroke-sun-ink" />
            <div class="flex flex-col text-sm leading-tight"><strong class="text-stone-900">{badge.title}</strong><span class="text-stone-700">{badge.sub}</span></div>
          </div>
        )}
      </div>
    </div>
  </section>

  <section id="calc" class="shell scroll-mt-28 py-[clamp(2rem,4vw,3.5rem)]" aria-label={h1}>
    <slot />
  </section>

  <div class="shell pb-6"><slot name="after" /></div>

  <section class="border-y border-sky-pastel-200 bg-sky-pastel-50" aria-labelledby="how-heading">
    <div class="shell max-w-[calc(var(--container-prose)+2*var(--spacing-gutter))] py-[clamp(2.5rem,5vw,4rem)]">
      <h2 id="how-heading" class="font-display-tight text-[clamp(1.75rem,3.2vw,2.5rem)] text-stone-900">{howHeading}</h2>
      <slot name="how" />
    </div>
  </section>

  {reads.length > 0 && (
    <section class="shell py-[clamp(2.5rem,5vw,4rem)]" aria-labelledby="reads-heading">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <h2 id="reads-heading" class="font-display-tight text-[clamp(1.75rem,3.2vw,2.5rem)] text-stone-900">{readsHeading}</h2>
        <a href={readsAll.href} class="inline-flex min-h-11 items-center font-semibold text-sun-ink underline underline-offset-4 hover:text-stone-900">{readsAll.label} &rarr;</a>
      </div>
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,15rem),1fr))] gap-4">
        {reads.map((r) => (
          <li>
            <a href={r.href} lang={r.lang} class="flex h-full flex-col overflow-hidden rounded-2xl border border-sky-pastel-300 bg-white text-stone-900 no-underline transition-[transform,box-shadow] duration-150 hover:-translate-y-[3px] hover:border-sky-pastel-600 hover:shadow-lift focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900 motion-reduce:transition-none motion-reduce:hover:translate-y-0" data-track="nav_click" data-track-placement={`${seg}_calc_reads`} data-track-target={r.href}>
              <div class="relative aspect-video bg-sky-pastel-100">
                <div class="absolute inset-0">{r.photo ? <PlacePhoto photo={r.photo} sizes="(min-width: 1024px) 240px, 50vw" credit="text" creditAt="bottom-right" /> : <Cover class="h-full w-full" cover={r.cover} coverAlt="" topic={r.topic} state="both" />}</div>
                <span class:list={['pointer-events-none absolute left-3 top-3 z-10 rounded-full px-2.5 py-1 text-xs font-bold text-stone-900', r.sun ? 'bg-sun-400' : 'bg-white']}>{r.tag}</span>
              </div>
              <div class="flex flex-1 flex-col gap-2 px-4 pb-4 pt-3.5">
                <strong class="font-display-tight text-lg leading-snug">{r.title}</strong>
                <span class="mt-auto text-sm font-semibold text-sun-ink">{readLabel} &rarr;</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
