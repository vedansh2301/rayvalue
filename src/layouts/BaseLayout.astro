---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/seo/SeoHead.astro';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/about". */
  path: string;
  noindex?: boolean;
  /** Path of the OG image; defaults to the site-wide one. */
  ogImagePath?: string;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD objects for this page. */
  jsonLd?: object[];
}

const { title, description, path, noindex = false, ogImagePath = '/og/default.png', ogType = 'website', jsonLd = [] } = Astro.props;
// Policy: trailingSlash 'never' + build.format 'directory' => canonical has no trailing slash (except root).
const canonical = new URL(path === '/' ? '/' : path.replace(/\/+$/, ''), Astro.site).href;
const fullTitle = path === '/' ? title : `${title} | RayValue`;
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fbbf24" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    {gscToken && <meta name="google-site-verification" content={gscToken} />}
    <SeoHead title={fullTitle} description={description} canonical={canonical} image={new URL(ogImagePath, Astro.site).href} type={ogType} jsonLd={jsonLd} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-stone-900 focus:px-3 focus:py-2 focus:text-white">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {beaconToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beaconToken })}></script>
    )}
  </body>
</html>
