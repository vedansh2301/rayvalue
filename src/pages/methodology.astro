---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { State } from '../data/schemas';
import { DB_PAGE_CACHE_HEADERS, loadUtilities } from '../lib/db/repo';

// Rendered on demand: the rate sources come from the database, so owner edits show up
// within ~5 minutes (CDN cache) without a redeploy.
export const prerender = false;
const loaded = await loadUtilities();
if (loaded.ok) for (const [k, v] of Object.entries(DB_PAGE_CACHE_HEADERS)) Astro.response.headers.set(k, v);
else {
  // Do not let the CDN keep the fallback page.
  Astro.response.headers.set('Cache-Control', 'no-store');
  console.error('methodology: utilities unavailable:', loaded.error.kind, loaded.error.message);
}
const utilities = loaded.ok ? loaded.value : null;

const states: { code: State; label: string }[] = [
  { code: 'FL', label: 'Florida' },
  { code: 'CA', label: 'California' },
];
---
<BaseLayout title="Methodology" description="How RayValue estimates solar system size, cost, savings and payback." path="/methodology">
  <div class="page">
    <h1>Methodology</h1>
    <p>TODO: Explain the calculation steps, data sources, and assumptions behind the calculators.</p>
    <p>TODO: Note that no federal tax credit is applied for installs in 2026 and later.</p>

    <h2>Utility rate sources</h2>
    <p>Rates come from each utility's own published tariff or rate pages. The page we read for each one:</p>
    {!utilities && <p>The list of rate sources is being verified. Please check back shortly.</p>}
    {utilities && states.map(({ code, label }) => (
      <>
        <h3>{label}</h3>
        <ul>
          {utilities.filter((u) => u.state === code).map((u) => (
            <li>
              <a href={u.source_url ?? undefined} rel="noopener">{u.name}, schedule {u.rate_schedule}</a>
              {u.verified_on && <> (read {u.verified_on})</>}
            </li>
          ))}
        </ul>
      </>
    ))}
  </div>
</BaseLayout>
