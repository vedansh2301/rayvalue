---
import { PAGE_META } from '../lib/seo/page-meta';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ogImagePath } from '../lib/seo/og';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/ui/PageHero.astro';
import type { State } from '../data/schemas';
import { DB_PAGE_CACHE_HEADERS, createRepo } from '../lib/db/repo';
import { isHttpUrl } from '../lib/city/view';
import { arrayText } from '../lib/calc/text';

// Rendered on demand: the sources and the PVWatts array come from the database, so owner edits
// show up within ~5 minutes (CDN cache) without a redeploy.
export const prerender = false;
const repo = createRepo();
const [loaded, costs, assumptions] = await Promise.all([repo.loadUtilities(), repo.loadCosts(), repo.loadAssumptions()]);
const failed = [loaded, costs, assumptions].filter((r) => !r.ok);
if (failed.length === 0) for (const [k, v] of Object.entries(DB_PAGE_CACHE_HEADERS)) Astro.response.headers.set(k, v);
else {
  // Do not let the CDN keep the fallback page.
  Astro.response.headers.set('Cache-Control', 'no-store');
  for (const r of failed) if (!r.ok) console.error('methodology: data unavailable:', r.error.kind, r.error.message);
}
const utilities = loaded.ok ? loaded.value : null;
const array = assumptions.ok ? assumptions.value.pvwatts_array : null;

// Lease / PPA inputs: shown when the owner has entered them, otherwise labeled as not yet verified.
const financing = assumptions.ok ? assumptions.value : null;
const pct = (n: number) => `${Math.round(n * 1000) / 10}%`;
const leasePpaRows: { label: string; row: { low: number | null; likely: number | null; high: number | null; rationale: string } | undefined; fmt: (n: number) => string }[] = [
  { label: 'Lease payment per kW of system per month, year 1', row: financing?.lease_monthly_per_kw, fmt: (n) => `$${n}` },
  { label: 'Lease yearly payment increase', row: financing?.lease_annual_escalator, fmt: pct },
  { label: 'PPA price per kWh, year 1', row: financing?.ppa_rate_per_kwh, fmt: (n) => `$${n}` },
  { label: 'PPA yearly price increase', row: financing?.ppa_annual_escalator, fmt: pct },
];
const leasePpaText = (r: (typeof leasePpaRows)[number]) =>
  r.row && r.row.low !== null && r.row.likely !== null && r.row.high !== null
    ? `${r.fmt(r.row.low)} to ${r.fmt(r.row.high)}, likely ${r.fmt(r.row.likely)}`
    : null;
const leasePpaShown = leasePpaRows.every((r) => leasePpaText(r) !== null);

const states: { code: State; label: string }[] = [
  { code: 'FL', label: 'Florida' },
  { code: 'CA', label: 'California' },
];

/** Distinct sources (by URL) with what they are used for. Only http(s) links are rendered. */
interface SourceItem { label: string; url: string | null; date: string | null }
const dedupe = (items: SourceItem[]) => {
  const seen = new Set<string>();
  return items.filter((i) => {
    const k = `${i.url ?? ''}|${i.label}`;
    if (seen.has(k)) return false;
    seen.add(k);
    return true;
  });
};
const avgRateSources = utilities
  ? dedupe(utilities.filter((u) => u.avg_rate_per_kwh).map((u) => ({ label: `${u.name} residential average rate`, url: u.avg_rate_per_kwh!.source_url, date: u.avg_rate_per_kwh!.verified_on })))
  : null;
const exportSources = utilities
  ? dedupe(utilities.filter((u) => u.avg_export_credit_per_kwh !== null).map((u) => ({ label: `${u.name} average export credit`, url: u.export_credit_source_url, date: u.export_credit_verified_on })))
  : null;
const exportNotes = utilities ? [...new Set(utilities.map((u) => (u.avg_export_credit_per_kwh !== null ? u.export_credit_note : null)).filter((n): n is string => !!n))] : [];
const costSources = costs.ok
  ? dedupe(
      states.flatMap(({ code, label }) => [
        { label: `${label} installed solar cost`, url: costs.value[code].installed_cost_per_watt.source_url, date: costs.value[code].installed_cost_per_watt.verified_on },
        { label: `${label} battery cost`, url: costs.value[code].battery_installed_cost.source_url, date: costs.value[code].battery_installed_cost.verified_on },
      ]),
    )
  : null;
---
<BaseLayout title={PAGE_META.methodology.title} description={PAGE_META.methodology.description} path="/methodology" ogImagePath={ogImagePath('methodology')}>
  <PageHero title="How we estimate solar payback" titleId="method-title" pose="magnifier">
    <Breadcrumbs slot="crumbs" tone="dark" items={[{ label: 'Home', href: '/' }, { label: 'Methodology' }]} />
    One method for every country: start from the country&rsquo;s own published rates and rules, show every input with its source and date, and give results as a low, likely and high range instead of a single number.
  </PageHero>

  <div class="page !pt-8">
    {/* TODO: owner review */}
    <h2 class="!mt-0">The rules we follow everywhere</h2>
    <ol class="list-decimal space-y-2 pl-6">
      <li><strong>Facts and assumptions are kept apart.</strong> A fact (a tariff, an export rate, a rebate, a statistic) is stored with the URL of its source and the date we last checked it. An assumption (how fast rates rise, how much solar a home uses itself) is stored with the reasoning behind it. Both are listed with every result.</li>
      <li><strong>No source, no number.</strong> If we cannot find a verified value, it is left out of the page rather than guessed.</li>
      <li><strong>Ranges, not precision.</strong> Costs, savings and payback are shown as low, likely and high estimates, because installer prices, your usage and future rates are all uncertain.</li>
      <li><strong>Only incentives that exist today.</strong> We do not count a rebate or tax credit that has ended or is not yet confirmed. For the United States, the federal residential clean energy credit (Section 25D) does not apply to installs in 2026 or later, so it is $0 in every US result.</li>
      <li><strong>An estimate is not a quote.</strong> Financing costs, maintenance, inverter and battery replacement are not included unless a calculator says so. Installer prices and your actual usage will differ.</li>
    </ol>

    <h2>Where each kind of number comes from</h2>
    <ul class="list-disc space-y-2 pl-6">
      <li><strong>Electricity prices and export payments:</strong> national energy regulators and the utilities&rsquo; own published tariffs, price caps and feed-in or export schemes.</li>
      <li><strong>Grants, rebates, VAT and tax treatment:</strong> the government, tax authority or agency that runs the scheme, read from its own publication.</li>
      <li><strong>Solar production:</strong> modelled from location. For the United States we use the PVWatts model from the National Laboratory of the Rockies (formerly NREL); for European locations we use the European Commission&rsquo;s PVGIS. A calculator that uses a different source says so.</li>
      <li><strong>Installed costs:</strong> published installed-price datasets and benchmarks, each labelled with its source.</li>
      <li><strong>Places, housing and population:</strong> national statistics offices, such as the US Census Bureau and Eurostat, for the location and size of the places we cover.</li>
    </ul>

    <h2>How figures are kept current</h2>
    <p>
      Rates and rules change. A scheduled job re-reads the source page behind each stored fact, respecting the site&rsquo;s robots.txt.
      A fact counts as confirmed only while the stored figure still appears in the source text. If the surrounding words now carry a
      different number, the fact is flagged for review instead of being published. Articles only use confirmed figures, and each
      one shows its sources and the date of its last check.
    </p>

    <h2>Both sides of the story</h2>
    <p>
      Our articles cover the case for solar and the case against it: when it pays back, when it does not, what a battery adds and costs,
      and where rule changes count against you. Offers and affiliate links sit beside the numbers and never feed the calculators.
      See the <a href="/affiliate-disclosure">affiliate disclosure</a> for how the site is funded.
    </p>

    <h2>Country calculators</h2>
    <p>
      Each country calculator lists its own inputs, sources and assumptions beside its results. The full workings for the United
      States calculators (Florida and California) follow, because they have the most inputs stored in our database. Browse the
      <a href="/#calculators">calculators</a> or pick a <a href="/#countries">country</a>.
    </p>

    <h2 id="united-states">United States: how an estimate is built</h2>
    <ol class="list-decimal space-y-2 pl-6">
      <li>
        <strong>Your usage, from your bill.</strong> We work backwards from your average monthly bill through your
        utility&rsquo;s published rates to estimate how much electricity you use in a year. For Florida utilities we use the
        tariff&rsquo;s fixed charge and tiered energy rates. For California utilities we subtract the fixed charge and divide by
        the utility&rsquo;s published residential average rate.
      </li>
      <li>
        <strong>Solar production.</strong> We place your ZIP code on the map and ask the PVWatts model from the National
        Laboratory of the Rockies (formerly NREL) how much one kilowatt of panels produces there each month, with system
        losses set by the amount of shade you pick.
        {array ? <> The array we model is {arrayText(array)}.</> : <> The modeled array settings are being verified.</>}{" "}
        If the live PVWatts service is unavailable, we use results precomputed with the same settings for the nearest listed city.
      </li>
      <li>
        <strong>System size.</strong> We size a system to cover a range of your estimated annual usage, up to a maximum size,
        which gives the low, likely and high system sizes. Very small results come with a note that solar may not pay off.
      </li>
      <li>
        <strong>Cost.</strong> We price that system with a range of installed costs per watt for your state, and add a range of
        installed battery costs if you choose one or two batteries. Costs are before any incentives.
      </li>
      <li>
        <strong>Savings, by metering rules.</strong> In Florida (retail net metering), each solar kilowatt-hour offsets one you
        would have bought, priced through your utility&rsquo;s tiers month by month; the fixed charge and any minimum bill still
        apply, and solar banked but unused at the end of the year is counted as worth nothing. In California (net billing,
        often called NEM 3.0), solar you use at home is valued at the retail rate, and solar you send to the grid earns a
        lower average export credit. A battery raises the share of solar used at home.
      </li>
      <li>
        <strong>Payback and long-term savings.</strong> We project savings year by year, with retail rates rising over time
        (a range of yearly increases) and panel output slowly declining. Payback is the year cumulative savings first exceed
        the upfront cost; net savings are total bill savings over the analysis period minus that cost. Future savings are not
        discounted.
      </li>
      <li>
        <strong>No federal tax credit.</strong> The federal residential clean energy credit (Section 25D) does not apply to
        installs in 2026 or later, so no federal credit is included anywhere in the results.
      </li>
    </ol>
    <p>
      Not included: financing costs, maintenance, inverter or battery replacement, and tax effects. An estimate is not a
      quote; installer prices and your actual usage will differ.
    </p>

    <h2>United States: lease and PPA comparison</h2>
    <p>
      Results include a plain-language comparison of buying with a lease or power purchase agreement (PPA), where a
      company owns the system and you pay monthly (lease) or per kilowatt-hour produced (PPA). The company that owns the
      system may be able to use federal tax benefits that homeowners who buy cannot, which can show up as lower prices.
    </p>
    {leasePpaShown ? (
      <>
        <p>
          When lease and PPA price assumptions are set, we use the same system as the purchase estimate, assume the contract
          runs for the whole analysis period, and subtract the payments from the likely-case bill savings. The low result uses
          the highest payments and the high result the lowest. It is not discounted and leaves out buyout and transfer fees.
          The assumptions in use:
        </p>
        <ul class="list-disc space-y-1 pl-6">
          {leasePpaRows.map((r) => <li>{r.label}: {leasePpaText(r)}. <span class="text-stone-700">{r.row?.rationale}</span></li>)}
        </ul>
      </>
    ) : (
      <p>
        We do not show lease or PPA prices yet. Lease and PPA pricing varies by installer, utility and contract, and we have
        not verified a source for typical market terms, so the comparison in results is explanation only. When we add figures
        they will be listed here as assumptions with their reasoning, and still shown as low, likely and high ranges.
      </p>
    )}

    <h2>United States: batteries in Florida</h2>
    <p>
      Under Florida retail net metering, solar you send to the grid is credited at the retail rate, so in our estimate a
      battery adds to the upfront cost but not to bill savings, and it lengthens payback. Its value is backup power during
      outages, which we do not put a dollar figure on. The Florida calculator page explains what a battery can and cannot power.
    </p>

    <h2>United States: types of sources</h2>
    <ul class="list-disc space-y-1 pl-6">
      <li>Utility tariff documents and rate pages, for fixed charges, energy rates and minimum bills.</li>
      <li>California Public Utilities Commission (CPUC) and Public Advocates Office reports, for California average rates, export credits and rate history.</li>
      <li>Lawrence Berkeley National Laboratory (LBNL) installed-price data from its Tracking the Sun work, for installed solar prices.</li>
      <li>U.S. Department of Energy (DOE) solar and storage cost benchmarks, for battery costs.</li>
      <li>The PVWatts model from the National Laboratory of the Rockies, for solar production.</li>
      <li>U.S. Census Bureau ZIP Code Tabulation Area data, for the location of each ZIP code.</li>
    </ul>
    <p>
      Choices that are ours rather than facts, such as how fast rates rise, how much solar a home uses directly, and the
      shade losses, are labeled as assumptions and listed in the &ldquo;How this estimate was built&rdquo; section of every result.
    </p>

    <h2>United States: utility rate sources</h2>
    <p>Rates come from each utility&rsquo;s own published tariff or rate pages. The page we read for each one:</p>
    {!utilities && <p>The list of rate sources is being verified.</p>}
    {utilities && states.map(({ code, label }) => (
      <>
        <h3>{label}</h3>
        <ul>
          {utilities.filter((u) => u.state === code).map((u) => (
            <li>
              {isHttpUrl(u.source_url) ? <a href={u.source_url} rel="noopener">{u.name}, schedule {u.rate_schedule}</a> : <>{u.name}, schedule {u.rate_schedule}</>}
              {u.verified_on && <> (read {u.verified_on})</>}
            </li>
          ))}
        </ul>
      </>
    ))}

    <h2>United States: California average rate and export credit sources</h2>
    {!avgRateSources || !exportSources ? (
      <p>These sources are being verified.</p>
    ) : (
      <>
        <ul>
          {[...avgRateSources, ...exportSources].map((s) => (
            <li>
              {isHttpUrl(s.url) ? <a href={s.url} rel="noopener">{s.label}</a> : <>{s.label} (source being verified)</>}
              {s.date && <> (read {s.date})</>}
            </li>
          ))}
        </ul>
        {exportNotes.map((n) => <p class="text-sm text-stone-700">Export credit: {n}</p>)}
      </>
    )}

    <h2>United States: cost sources</h2>
    {!costSources ? (
      <p>The list of cost sources is being verified.</p>
    ) : (
      <ul>
        {costSources.map((s) => (
          <li>
            {isHttpUrl(s.url) ? <a href={s.url} rel="noopener">{s.label}</a> : <>{s.label} (source being verified)</>}
            {s.date && <> (read {s.date})</>}
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
