---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { publishedPosts } from '../../lib/blog';

const posts = await publishedPosts();
// No published posts: a short pointer to the calculators, noindex (and out of the sitemap, see astro.config.mjs).
const empty = posts.length === 0;
const day = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout title="RayValue blog" description="News and analysis on solar and battery costs, rates and payback for Florida and California homeowners." path="/blog" noindex={empty}>
  <div class="page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />
    <h1>Blog</h1>
    {empty ? (
      <p>To see what solar and a battery could cost and save on your home, use the <a href="/calculator/florida">Florida calculator</a> or the <a href="/calculator/california">California calculator</a>. The <a href="/methodology">methodology</a> page explains how the estimates are made.</p>
    ) : (
      <ul class="mt-4 space-y-6">
        {posts.map((p) => (
          <li>
            <a class="text-lg font-semibold underline underline-offset-4" href={`/blog/${p.id}`}>{p.data.title}</a>
            <p class="text-sm text-stone-600"><time datetime={day(p.data.published)}>{day(p.data.published)}</time></p>
            <p class="text-stone-700">{p.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
