---
import { PAGE_META } from '../../lib/seo/page-meta';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Index from '../../components/content/Index.astro';
import { publishedPosts } from '../../lib/blog';
import { displayDate } from '../../lib/dates';
import { coverTopic, readMinutes, stateKey } from '../../lib/content/cards';

const posts = await publishedPosts();
// No published posts: a short pointer to the calculators, noindex (and out of the sitemap, see astro.config.mjs).
const empty = posts.length === 0;
const items = posts.map((p) => ({
  href: `/blog/${p.id}`,
  title: p.data.title,
  description: p.data.description,
  topic: coverTopic({ topic: p.data.topic, tags: p.data.tags, title: p.data.title, state: p.data.state }),
  state: stateKey(p.data.state),
  dateLabel: displayDate(p.data.published),
  datetime: p.data.published.toISOString().slice(0, 10),
  readMin: readMinutes(p.body),
}));
---
<BaseLayout title={PAGE_META.blog.title} description={PAGE_META.blog.description} ogImagePath="/og/blog.png" path="/blog" noindex={empty}>
  {empty ? (
    <div class="page">
      <h1>Blog</h1>
      <p>To see what solar and a battery could cost and save on your home, use the <a href="/calculator/florida">Florida calculator</a> or the <a href="/calculator/california">California calculator</a>. The <a href="/methodology">methodology</a> page explains how the estimates are made.</p>
    </div>
  ) : (
    <Index kind="blog" heading="Blog" intro="Plain-language posts on solar, batteries and electricity bills in Florida and California, each with its sources listed." items={items} />
  )}
</BaseLayout>
