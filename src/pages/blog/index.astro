---
import { PAGE_META } from '../../lib/seo/page-meta';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { publishedPosts } from '../../lib/blog';
import { displayDate } from '../../lib/dates';
import { stateTag } from '../../lib/content/tags';

const posts = await publishedPosts();
// No published posts: a short pointer to the calculators, noindex (and out of the sitemap, see astro.config.mjs).
const empty = posts.length === 0;
const day = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout title={PAGE_META.blog.title} description={PAGE_META.blog.description} ogImagePath="/og/blog.png" path="/blog" noindex={empty}>
  <div class="page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />
    <h1 class="mt-4">Blog</h1>
    <p class="mt-3 text-lg leading-8 text-stone-700">Plain-language posts on solar, batteries and electricity bills in Florida and California, each with its sources listed.</p>
    {empty ? (
      <p>To see what solar and a battery could cost and save on your home, use the <a href="/calculator/florida">Florida calculator</a> or the <a href="/calculator/california">California calculator</a>. The <a href="/methodology">methodology</a> page explains how the estimates are made.</p>
    ) : (
      <ul class="not-prose mt-8 grid gap-6 sm:grid-cols-2">
        {posts.map((p) => (
          <li class="relative flex flex-col rounded-xl border border-stone-200 bg-white p-5 shadow-sm focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-stone-900 hover:border-sun-400">
            <p class="text-xs font-medium uppercase tracking-wide text-stone-600">{stateTag(p.data.state)}</p>
            <h2 class="mt-2! text-lg font-semibold leading-snug text-stone-900"><a class="no-underline hover:underline underline-offset-4 after:absolute after:inset-0 focus-visible:outline-none" href={`/blog/${p.id}`}>{p.data.title}</a></h2>
            <p class="mt-2 leading-7 text-stone-700">{p.data.description}</p>
            <p class="mt-auto pt-3 text-sm text-stone-600"><time datetime={day(p.data.published)}>{displayDate(p.data.published)}</time></p>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
