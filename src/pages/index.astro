---
// Global home. Everything here is computed from the content collections and the place index: no typed-in counts, rates or dates.
// On demand (like the country hubs) because place counts come from the database; failure just hides the place counts.
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGE_META } from '../lib/seo/page-meta';
import { ogImagePath } from '../lib/seo/og';
import { btnPrimary, btnSecondary } from '../components/ui/buttons';
import { loadPlaceIndexEntries } from '../lib/places/index-entries';
import { publishedCityLinks } from '../lib/seo/city-links';
import { DB_PAGE_CACHE_HEADERS } from '../lib/db/repo';
import { buildCountryCards, cardCounts, deadlineLinks, groupByRegion, latestGuideLinks, liveCalculators, type HomeArticle, type PlaceCounts } from '../lib/home/global-home';

const [guides, posts, places, cities] = await Promise.all([
  getCollection('guides', (e) => !e.data.draft),
  getCollection('blog', (e) => !e.data.draft),
  loadPlaceIndexEntries(),
  publishedCityLinks(),
]);
const articles: HomeArticle[] = [
  ...guides.map((e): HomeArticle => ({ collection: 'guides', id: e.id, route: e.data.route, country: e.data.country, lang: e.data.lang, title: e.data.title, description: e.data.description, published: e.data.published, updated: e.data.updated, noindex: e.data.noindex })),
  ...posts.map((e): HomeArticle => ({ collection: 'blog', id: e.id, country: e.data.country, lang: e.data.lang, title: e.data.title, description: e.data.description, published: e.data.published, updated: e.data.updated, noindex: e.data.noindex })),
];
const placeCounts: Record<string, PlaceCounts> = {};
if (places.ok) {
  for (const e of places.value) {
    if (e.type !== 'places') continue;
    const c = (placeCounts[e.country] ??= { places: 0, hubs: 0 });
    if (e.placeKind === 'hub') c.hubs += 1; else c.places += 1;
  }
  for (const [k, v] of Object.entries(DB_PAGE_CACHE_HEADERS)) Astro.response.headers.set(k, v);
} else {
  Astro.response.headers.set('Cache-Control', 'no-store');
}
const groups = groupByRegion(buildCountryCards(articles, placeCounts, { places: cities.length }));
const calculators = liveCalculators();
const deadlines = deadlineLinks(articles);
const latest = latestGuideLinks(articles, 6, 1);
const link = 'text-sun-ink underline underline-offset-2 hover:text-stone-900';
const h2 = 'text-2xl font-bold tracking-tight text-stone-900';
const trust = ['Free to use', 'No sign-up for the calculators', 'Every assumption shown', 'Independent, not a utility'];
const method = [
  { title: 'Official sources', body: 'Tariffs, export rates, grants and tax rules come from regulators, governments and utilities.' },
  { title: 'Every number links to its source', body: 'Each figure shows where it came from and the date we last checked it. If we cannot verify a number, we leave it out.' },
  { title: 'Ranges, not promises', body: 'Results are low, likely and high estimates, with the assumptions behind them listed in full.' },
];
---
<BaseLayout title={PAGE_META.home.title} description={PAGE_META.home.description} path="/" ogImagePath={ogImagePath('home')}>
  <section class="bg-gradient-to-b from-sun-100 to-stone-50">
    <div class="shell pb-10 pt-14 sm:pb-14 sm:pt-20">
      <h1 class="max-w-(--container-prose) text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl">Does solar pay off where you live?</h1>
      <p class="mt-5 max-w-(--container-prose) text-lg leading-8 text-stone-700">
        Independent payback math from official tariffs, export rates and grants, country by country. Pick your country to see what changes, what it costs and what to do before a deadline.
      </p>
      <div class="mt-6 flex flex-col gap-2 sm:flex-row">
        <a href="#countries" class={btnPrimary}>Choose your country<span aria-hidden="true">&darr;</span></a>
        <a href="#calculators" class={btnSecondary}>See the calculators</a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-1 text-sm font-medium text-stone-800" aria-label="Why use RayValue">
        {trust.map((t) => (
          <li class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="shrink-0 text-sun-ink">
              <path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            {t}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="countries" class="shell scroll-mt-4 py-12" aria-labelledby="countries-heading">
    <h2 id="countries-heading" class={h2}>Choose your country</h2>
    <p class="mt-2 max-w-(--container-prose) text-stone-700">Each country has its own rules, rates and deadlines, so each has its own guides and local data. Counts below are what is published today.</p>
    {groups.map((g, i) => (
      <div class="mt-8" role="group" aria-labelledby={`region-${i}`}>
        <h3 id={`region-${i}`} class="text-sm font-semibold uppercase tracking-wide text-stone-600">{g.region}</h3>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {g.cards.map((c) => (
            <li>
              <a href={c.href} class="flex h-full min-h-11 flex-col rounded-xl border border-stone-200 bg-white p-4 no-underline shadow-sm transition-colors hover:border-sun-400 hover:bg-sun-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900" data-track="nav_click" data-track-placement="home_countries" data-track-target={c.href}>
                <span class="flex items-baseline justify-between gap-3">
                  <span class="text-lg font-semibold text-stone-900">{c.name}</span>
                  <span aria-hidden="true" class="text-sun-ink">&rarr;</span>
                </span>
                {c.localName && <span lang={c.localLang ?? undefined} class="text-sm text-stone-700">{c.localName}</span>}
                <span class="mt-2 text-sm text-stone-700">{cardCounts(c)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section id="calculators" class="shell scroll-mt-4 pb-14" aria-labelledby="calculators-heading">
    <h2 id="calculators-heading" class={h2}>Calculators</h2>
    <p class="mt-2 max-w-(--container-prose) text-stone-700">Cost, savings and payback as low, likely and high ranges, using local rates. More countries are being added.</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {calculators.map((c) => (
        <li class="flex flex-col rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
          <p class="text-sm font-medium text-sun-ink">{c.country}</p>
          <h3 class="mt-1 text-xl font-semibold text-stone-900">{c.label}</h3>
          <p class="mt-1 flex-1 leading-7 text-stone-700">{c.fact}</p>
          <a href={c.href} class={`mt-4 w-fit ${btnPrimary}`} data-track="nav_click" data-track-placement="home_calculators" data-track-target={c.href}>Open calculator<span aria-hidden="true">&rarr;</span></a>
        </li>
      ))}
    </ul>
  </section>

  {deadlines.length > 0 && (
    <section id="deadlines" class="shell scroll-mt-4 pb-14" aria-labelledby="deadlines-heading">
      <h2 id="deadlines-heading" class={h2}>Deadlines that matter</h2>
      <p class="mt-2 max-w-(--container-prose) text-stone-700">Rebates, tax treatment and net metering rules change on fixed dates. These guides explain what the date means for you.</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {deadlines.map((d) => (
          <li class="rounded-xl border border-stone-200 bg-white p-5">
            <p class="text-sm font-medium text-sun-ink">{d.countryName}</p>
            <a href={d.href} lang={d.lang} class="mt-1 inline-block text-lg font-semibold leading-snug text-stone-900 underline-offset-4 hover:text-sun-ink hover:underline" data-track="nav_click" data-track-placement="home_deadlines" data-track-target={d.href}>{d.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {latest.length > 0 && (
    <section id="guides" class="shell scroll-mt-4 pb-14" aria-labelledby="guides-heading">
      <h2 id="guides-heading" class={h2}>Latest guides</h2>
      <ul class="mt-4 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
        {latest.map((g) => (
          <li>
            <a href={g.href} lang={g.lang} class="flex min-h-11 flex-col gap-0.5 px-4 py-3 text-stone-900 no-underline hover:bg-sun-50 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4" data-track="nav_click" data-track-placement="home_latest" data-track-target={g.href}>
              <span class="font-medium">{g.title}</span>
              <span lang="en" class="shrink-0 text-sm text-stone-700">{g.countryName}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-stone-700">Every country has its own guide list: pick a country above.</p>
    </section>
  )}

  <section class="shell pb-16" aria-labelledby="method-heading">
    <div class="rounded-2xl border border-sun-300 bg-sun-50 p-6 sm:p-8">
      <h2 id="method-heading" class={h2}>How we keep the numbers honest</h2>
      <ul class="mt-5 grid gap-5 sm:grid-cols-3">
        {method.map((m) => (
          <li>
            <h3 class="font-semibold text-stone-900">{m.title}</h3>
            <p class="mt-1 leading-7 text-stone-800">{m.body}</p>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-stone-800">Read the <a href="/methodology" class={link}>methodology</a>. RayValue is an independent site, not a utility or a government agency. See the <a href="/affiliate-disclosure" class={link}>affiliate disclosure</a> for how the site is funded.</p>
    </div>
  </section>
</BaseLayout>
