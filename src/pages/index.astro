---
import BaseLayout from '../layouts/BaseLayout.astro';
import { btnPrimary, btnSecondary } from '../components/ui/buttons';

const states = [
  { name: 'Florida', code: 'FL', href: '/calculator/florida', blurb: 'Florida utilities credit the solar you send to the grid through net metering, and we price it through your utility\u2019s own tiered rates. See what rooftop solar and a battery are worth on FPL, Duke Energy Florida or TECO.' },
  { name: 'California', code: 'CA', href: '/calculator/california', blurb: 'Export credits and self-consumption shape the math here. See how solar and a battery affect payback on PG&E, SCE or SDG&E.' },
];
const steps = [
  { title: 'Tell us about your home', body: 'Pick your state and utility, then enter your average monthly bill and whether you want a battery.' },
  { title: 'We run the numbers', body: 'We size a system to your usage, estimate local sun, and apply your utility’s actual rate and export rules.' },
  { title: 'See a realistic range', body: 'Get low, likely and high estimates for cost, savings and payback, with every assumption listed.' },
];
---
<BaseLayout
  title="RayValue | Solar payback calculator for Florida and California homeowners"
  description="Honest solar and battery payback estimates for Florida and California homeowners, calculated without the federal tax credit."
  path="/"
>
  <section class="bg-gradient-to-b from-sun-100 to-stone-50">
    <div class="shell pb-7 pt-14 sm:pb-10 sm:pt-20">
      <h1 class="max-w-(--container-prose) text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl">
        Does solar still pay off without the federal tax credit?
      </h1>
      <p class="mt-5 max-w-(--container-prose) text-lg leading-8 text-stone-700">
        The federal residential solar tax credit has ended for new installs. RayValue shows Florida and California homeowners what rooftop solar and batteries are worth today, as honest ranges, using your own utility&rsquo;s rates.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/quotes?source=home" class={btnPrimary}>Get free installer quotes<span aria-hidden="true">&rarr;</span></a>
        <a href="/calculator/florida" class={btnSecondary}>Check my payback</a>
      </div>
      <p class="mt-4 max-w-(--container-prose) text-sm text-stone-600">Free, no sign-up, and no phone calls.</p>
    </div>
  </section>

  <section class="shell py-12" aria-labelledby="pick-state">
    <h2 id="pick-state" class="text-2xl font-bold tracking-tight text-stone-900">Choose your state</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2">
      {states.map((s) => (
        <li class="flex flex-col rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
          <h3 class="text-xl font-semibold text-stone-900">{s.name}</h3>
          <p class="mt-2 flex-1 leading-7 text-stone-700">{s.blurb}</p>
          <a href={s.href} class={`mt-5 w-fit ${btnPrimary}`}>
            {s.name} calculator<span aria-hidden="true">&rarr;</span>
          </a>
          <a href={`/quotes?state=${s.code}&source=home`} class="mt-2 inline-flex min-h-11 w-fit items-center font-medium text-sun-ink underline underline-offset-4 hover:text-stone-900">
            Get quotes in {s.name}<span aria-hidden="true" class="ml-1">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="shell pb-16" aria-labelledby="how-it-works">
    <h2 id="how-it-works" class="text-2xl font-bold tracking-tight text-stone-900">How it works</h2>
    <ol class="mt-6 grid gap-5 sm:grid-cols-3">
      {steps.map((s, i) => (
        <li class="rounded-xl border border-stone-200 bg-white p-6">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-sun-400 font-bold text-stone-900" aria-hidden="true">{i + 1}</span>
          <h3 class="mt-3 font-semibold text-stone-900">{s.title}</h3>
          <p class="mt-2 leading-7 text-stone-700">{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="mt-6 max-w-(--container-prose) text-stone-700">Curious about the details? Read our <a href="/methodology" class="text-sun-ink underline underline-offset-2 hover:text-stone-900">methodology</a>.</p>
  </section>
</BaseLayout>
