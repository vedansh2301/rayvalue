---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ogImagePath } from '../lib/seo/og';
import { btnPrimary, btnSecondary } from '../components/ui/buttons';
import UtilityLinks from '../components/utility/UtilityLinks.astro';
import Icon, { type IconName } from '../components/icons/Icon';
import { Picture } from 'astro:assets';
import heroPhoto from '../assets/photos/ca-rooftop-solar-home.jpg';
import Faq from '../components/Faq.astro';
import { HOME_FAQ_IDS, faqItems } from '../lib/content/faq';
import { faqJsonLd } from '../lib/seo/jsonld';

const faq = faqItems(HOME_FAQ_IDS);
const trust = ['Free', 'No sign-up for the calculator', 'Every assumption shown', 'Independent, not a utility'];
const forYou = [
  { title: 'Free for homeowners', body: 'The calculator and quote requests cost you nothing, and you are never obligated to buy.' },
  { title: 'Installers pay to be introduced', body: 'Installers pay RayValue for introductions to homeowners who ask to hear from them. That is how the site is funded.' },
  { title: 'You choose who contacts you', body: 'You decide whether to request quotes at all. If you do, the consent wording names the installers who may contact you, and you can opt out at any time.' },
];

const states = [
  { name: 'Florida', code: 'FL', icon: 'florida' as IconName, fact: 'Net metering \u00b7 tiered rates', href: '/calculator/florida', blurb: 'Florida utilities credit the solar you send to the grid through net metering, and we price it through your utility\u2019s own tiered rates. See what rooftop solar and a battery are worth on FPL, Duke Energy Florida or TECO.' },
  { name: 'California', code: 'CA', icon: 'california' as IconName, fact: 'NEM 3.0 \u00b7 batteries matter', href: '/calculator/california', blurb: 'Export credits and self-consumption shape the math here. See how solar and a battery affect payback on PG&E, SCE or SDG&E.' },
];
const steps: { title: string; body: string; icon: IconName }[] = [
  { icon: 'clipboard', title: 'Tell us about your home', body: 'Pick your state and utility, then enter your average monthly bill and whether you want a battery.' },
  { icon: 'chart', title: 'We run the numbers', body: 'We size a system to your usage, estimate local sun, and apply your utility’s actual rate and export rules.' },
  { icon: 'scale', title: 'See a realistic range', body: 'Get low, likely and high estimates for cost, savings and payback, with every assumption listed.' },
];
---
<BaseLayout
  title="RayValue | Solar payback calculator for Florida and California homeowners"
  description="Honest solar and battery payback estimates for Florida and California homeowners, calculated without the federal tax credit."
  path="/"
  ogImagePath={ogImagePath('home')}
  jsonLd={[faqJsonLd(faq)]}
>
  <section class="bg-gradient-to-b from-sun-100 to-stone-50">
    <div class="shell grid items-center gap-8 pb-7 pt-14 sm:pb-10 sm:pt-20 lg:grid-cols-[3fr_2fr]">
     <div>
      <h1 class="max-w-(--container-prose) text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl">
        See if solar pays off on your home &mdash; using your actual utility rates
      </h1>
      <p class="mt-5 max-w-(--container-prose) text-lg leading-8 text-stone-700">
        The federal tax credit is gone, so we show Florida and California homeowners honest cost, savings and payback ranges from their own utility&rsquo;s rates.
      </p>
      <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-start">
        <div role="group" aria-labelledby="hero-state-label" class="flex flex-col gap-2">
          <p id="hero-state-label" class="text-sm font-medium text-stone-700">Pick your state to start</p>
          <div class="flex flex-col gap-2 sm:flex-row">
            <a href="/calculator/florida" class={btnPrimary}>Check my payback<span class="font-normal">&middot; Florida</span><span aria-hidden="true">&rarr;</span></a>
            <a href="/calculator/california" class={btnPrimary}>Check my payback<span class="font-normal">&middot; California</span><span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
        <a href="/quotes?source=home" class={`${btnSecondary} sm:self-end`}>Get installer quotes</a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-1 text-sm font-medium text-stone-800" aria-label="Why use RayValue">
        {trust.map((t) => (
          <li class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false" class="shrink-0 text-sun-ink">
              <path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            {t}
          </li>
        ))}
      </ul>
     </div>
     <div class="mx-auto w-full max-w-md lg:max-w-none">
       <Picture
         src={heroPhoto}
         formats={['avif', 'webp']}
         widths={[480, 768, 1100]}
         sizes="(min-width: 1024px) 440px, (min-width: 480px) 448px, calc(100vw - 2rem)"
         alt="Dark rooftop solar panels on a single-story home in California under a clear blue sky"
         width={1100}
         height={825}
         loading="eager"
         fetchpriority="high"
         decoding="async"
         class="aspect-[4/3] w-full rounded-2xl object-cover shadow-md"
       />
     </div>
    </div>
  </section>

  <section class="shell py-12" aria-labelledby="pick-state">
    <h2 id="pick-state" class="text-2xl font-bold tracking-tight text-stone-900">Choose your state</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2">
      {states.map((s) => (
        <li class="flex flex-col rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <Icon name={s.icon} size={32} class="text-stone-900" />
            <div>
              <h3 class="text-xl font-semibold text-stone-900">{s.name}</h3>
              <p class="text-sm font-medium text-sun-ink">{s.fact}</p>
            </div>
          </div>
          <p class="mt-2 flex-1 leading-7 text-stone-700">{s.blurb}</p>
          <div class="mt-4"><UtilityLinks state={s.code as 'FL' | 'CA'} /></div>
          <a href={s.href} class={`mt-3 w-fit ${btnPrimary}`}>
            {s.name} calculator<span aria-hidden="true">&rarr;</span>
          </a>
          <a href={`/quotes?state=${s.code}&source=home`} class="mt-2 inline-flex min-h-11 w-fit items-center font-medium text-sun-ink underline underline-offset-4 hover:text-stone-900">
            Get quotes in {s.name}<span aria-hidden="true" class="ml-1">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="shell pb-16" aria-labelledby="how-it-works">
    <h2 id="how-it-works" class="text-2xl font-bold tracking-tight text-stone-900">How it works</h2>
    <ol class="mt-6 grid gap-5 sm:grid-cols-3">
      {steps.map((s, i) => (
        <li class="rounded-xl border border-stone-200 bg-white p-6">
          <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-sun-100 text-stone-900"><Icon name={s.icon} /></span>
            <span class="text-sm font-bold text-sun-ink">Step {i + 1}</span>
          </div>
          <h3 class="mt-3 font-semibold text-stone-900">{s.title}</h3>
          <p class="mt-2 leading-7 text-stone-700">{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="mt-6 max-w-(--container-prose) text-stone-700">Curious about the details? Read our <a href="/methodology" class="text-sun-ink underline underline-offset-2 hover:text-stone-900">methodology</a>.</p>
  </section>

  <section class="shell pb-16" aria-labelledby="for-you">
    <h2 id="for-you" class="text-2xl font-bold tracking-tight text-stone-900">How RayValue works for you</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-3">
      {forYou.map((c) => (
        <li class="rounded-xl border border-stone-200 bg-white p-6">
          <h3 class="font-semibold text-stone-900">{c.title}</h3>
          <p class="mt-2 leading-7 text-stone-700">{c.body}</p>
        </li>
      ))}
    </ul>
    <p class="mt-6 max-w-(--container-prose) text-stone-700">See the <a href="/affiliate-disclosure" class="text-sun-ink underline underline-offset-2 hover:text-stone-900">affiliate disclosure</a> and <a href="/about" class="text-sun-ink underline underline-offset-2 hover:text-stone-900">about RayValue</a>.</p>
  </section>

  <div class="shell pb-16">
    <div class="max-w-(--container-prose)">
      <Faq items={faq} id="home-faq" />
    </div>
  </div>
</BaseLayout>
