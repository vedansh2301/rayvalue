---
// Global home. Everything here is computed from the content collections and the place index: no typed-in counts, rates or dates.
// On demand (like the country hubs) because place counts come from the database; failure just hides the place counts.
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Ray from '../components/brand/Ray.astro';
import CountryOutline from '../components/brand/CountryOutline.astro';
import { Image } from 'astro:assets';
import { countryCalculator } from '../lib/content/country-calc';
import photoHome from '../assets/photos/ca-home-tile-roof-solar.jpg';
import photoInstall from '../assets/photos/ca-rooftop-solar-install.jpg';
import photoCommunity from '../assets/photos/covers/community-solar-florida-california.jpg';
import photoPrices from '../assets/photos/covers/residential-solar-prices-2026.jpg';
import photoFarm from '../assets/photos/covers/rooftop-vs-utility-solar-costs-bcg-lazard.jpg';
import { PAGE_META } from '../lib/seo/page-meta';
import { ogImagePath } from '../lib/seo/og';
import { btnPrimary, btnOnDark } from '../components/ui/buttons';
import { loadPlaceIndexEntries } from '../lib/places/index-entries';
import { publishedCityLinks } from '../lib/seo/city-links';
import { DB_PAGE_CACHE_HEADERS } from '../lib/db/repo';
import { buildCountryCards, cardCounts, deadlineLinks, groupByRegion, liveCalculators, siteTotals, topCountries, type HomeArticle, type PlaceCounts } from '../lib/home/global-home';

const [guides, posts, places, cities] = await Promise.all([
  getCollection('guides', (e) => !e.data.draft),
  getCollection('blog', (e) => !e.data.draft),
  loadPlaceIndexEntries(),
  publishedCityLinks(),
]);
const articles: HomeArticle[] = [
  ...guides.map((e): HomeArticle => ({ collection: 'guides', id: e.id, route: e.data.route, country: e.data.country, lang: e.data.lang, title: e.data.title, description: e.data.description, published: e.data.published, updated: e.data.updated, noindex: e.data.noindex })),
  ...posts.map((e): HomeArticle => ({ collection: 'blog', id: e.id, country: e.data.country, lang: e.data.lang, title: e.data.title, description: e.data.description, published: e.data.published, updated: e.data.updated, noindex: e.data.noindex })),
];
const placeCounts: Record<string, PlaceCounts> = {};
if (places.ok) {
  for (const e of places.value) {
    if (e.type !== 'places') continue;
    const c = (placeCounts[e.country] ??= { places: 0, hubs: 0 });
    if (e.placeKind === 'hub') c.hubs += 1; else c.places += 1;
  }
  for (const [k, v] of Object.entries(DB_PAGE_CACHE_HEADERS)) Astro.response.headers.set(k, v);
} else {
  Astro.response.headers.set('Cache-Control', 'no-store');
}
const cards = buildCountryCards(articles, placeCounts, { places: cities.length });
const featured = topCountries(cards, 5);
const featuredSegs = new Set(featured.map((c) => c.segment));
const more = groupByRegion(cards.filter((c) => !featuredSegs.has(c.segment)));
const totals = siteTotals(cards);
const calculators = liveCalculators();
const deadlines = deadlineLinks(articles).slice(0, 4);
const hasCalc = (seg: string) => seg === 'us' || countryCalculator(seg) !== null;
const link = 'text-sun-ink underline underline-offset-2 hover:text-stone-900';
const h2 = 'font-display-tight text-3xl text-stone-900 sm:text-4xl';
const photos = [
  { src: photoHome, alt: 'Aerial view of a home with dark solar panels on a red tile roof', credit: 'Residential rooftop array, California. U.S. Department of Energy' },
  { src: photoInstall, alt: 'Installers lifting a solar panel into place on a tile roof', credit: 'Rooftop installation. U.S. Department of Energy' },
  { src: photoCommunity, alt: 'Aerial view of a community solar array in a wooded clearing', credit: 'Community solar array, Massachusetts. U.S. Department of Energy' },
  { src: photoPrices, alt: 'An installer fixing mounting rails to a tile roof', credit: 'Installing mounting rails. U.S. Department of Energy' },
  { src: photoFarm, alt: 'Aerial view of a large ground-mounted solar farm', credit: 'Solar farm at Kennedy Space Center, Florida. NASA' },
];
const method = [
  { title: 'Official sources first', body: 'Tariffs, export rates, grants and tax rules come from regulators, governments and utilities.' },
  { title: 'Every number shows its source', body: 'Each figure carries its source and the date we checked it. If we cannot verify it, we leave it out.' },
  { title: 'Ranges, not promises', body: 'Low, likely and high estimates, with every assumption listed.' },
];
---
<BaseLayout title={PAGE_META.home.title} description={PAGE_META.home.description} path="/" ogImagePath={ogImagePath('home')}>
  <PageHero title="Does solar pay off where you live?" size="lg" pose="wave">
    Independent solar and battery payback math for homeowners worldwide, from each country&rsquo;s own tariffs, export rates and grants.
    <Fragment slot="actions">
      <a href="#countries" class={btnPrimary}>Choose your country</a>
      <a href="#calculators" class={btnOnDark}>Run a calculator</a>
    </Fragment>
  </PageHero>

  <section id="countries" class="shell scroll-mt-4 py-12" aria-labelledby="countries-heading">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
      <h2 id="countries-heading" class={h2}>Pick your country</h2>
      <p class="text-stone-700">{totals.countries} countries so far. Each has its own rules and local data.</p>
    </div>
    <ul class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4 lg:grid-rows-2">
      {featured.map((c, i) => (
        <li class:list={['relative', i === 0 && 'col-span-2 lg:row-span-2']}>
          <a
            href={c.href}
            class:list={[
              'group relative flex h-full min-h-44 flex-col justify-end overflow-hidden rounded-2xl p-4 no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900',
              i === 0 ? 'min-h-56 bg-ink-900 text-white hover:bg-ink-800 sm:p-6' : 'border border-stone-200 bg-white text-stone-900 hover:border-sun-500 hover:bg-sun-50',
            ]}
            data-track="nav_click" data-track-placement="home_bento" data-track-target={c.href}
          >
            <CountryOutline segment={c.segment} class:list={['absolute right-3 top-3 w-auto transition-transform group-hover:scale-105', i === 0 ? 'h-32 text-sun-400 sm:h-48 lg:h-64' : 'h-14 text-sun-300 sm:h-16']} />
            {hasCalc(c.segment) && <span class:list={['mb-2 w-fit rounded-full px-2.5 py-0.5 text-xs font-semibold', i === 0 ? 'bg-sun-400 text-stone-900' : 'bg-sun-100 text-sun-ink']}>Calculator</span>}
            <span class:list={['font-display-tight', i === 0 ? 'text-4xl sm:text-5xl' : 'text-2xl']}>{c.name}</span>
            {c.localName && <span lang={c.localLang ?? undefined} class:list={['text-sm', i === 0 ? 'text-ink-200' : 'text-stone-700']}>{c.localName}</span>}
            <span class:list={['mt-1 text-sm', i === 0 ? 'text-ink-100' : 'text-stone-700']}>{cardCounts(c)}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
      {more.map((g, i) => (
        <div role="group" aria-labelledby={`more-${i}`}>
          <p id={`more-${i}`} class="text-sm font-semibold text-stone-700">Also in {g.region}</p>
          <ul class="mt-1 flex flex-wrap gap-x-1">
            {g.cards.map((c) => (
              <li><a href={c.href} class="inline-flex min-h-11 items-center rounded-md px-2 font-medium text-sun-ink underline-offset-4 hover:bg-sun-50 hover:underline" data-track="nav_click" data-track-placement="home_more" data-track-target={c.href}>{c.name}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="shell grid gap-4 pb-12 lg:grid-cols-[3fr_2fr]" aria-label="Calculators and deadlines">
    <div id="calculators" class="scroll-mt-4 rounded-2xl border border-stone-200 bg-white p-5 sm:p-6" role="group" aria-labelledby="calculators-heading">
      <div class="flex items-center gap-3">
        <Ray pose="point" size={88} class="shrink-0" />
        <div>
          <h2 id="calculators-heading" class="font-display-tight text-2xl text-stone-900 sm:text-3xl">Run your numbers</h2>
          <p class="mt-1 text-stone-700">Low, likely and high ranges from your country&rsquo;s own rates. No sign-up.</p>
        </div>
      </div>
      <ul class="mt-4 divide-y divide-stone-200">
        {calculators.map((c) => (
          <li>
            <a href={c.href} class="group flex min-h-11 items-center justify-between gap-3 py-3 no-underline" data-track="nav_click" data-track-placement="home_calculators" data-track-target={c.href}>
              <span>
                <span class="block font-semibold text-stone-900 group-hover:text-sun-ink group-hover:underline underline-offset-4">{c.label}{c.label !== c.country && <span class="font-normal text-stone-700"> ({c.country})</span>}</span>
                <span class="block text-sm text-stone-700">{c.fact}</span>
              </span>
              <span aria-hidden="true" class="text-sun-ink">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    {deadlines.length > 0 && (
      <div id="deadlines" class="scroll-mt-4 rounded-2xl bg-sun-100 p-5 sm:p-6" role="group" aria-labelledby="deadlines-heading">
        <div class="flex items-center gap-3">
          <Ray pose="calendar" size={88} class="shrink-0" />
          <h2 id="deadlines-heading" class="font-display-tight text-2xl text-stone-900 sm:text-3xl">Dates that change the maths</h2>
        </div>
        <ul class="mt-4 space-y-3">
          {deadlines.map((d) => (
            <li class="border-l-4 border-sun-500 pl-3">
              <p class="text-sm font-medium text-sun-ink">{d.countryName}</p>
              <a href={d.href} lang={d.lang} class="inline-block py-0.5 font-semibold leading-snug text-stone-900 underline-offset-4 hover:text-sun-ink hover:underline" data-track="nav_click" data-track-placement="home_deadlines" data-track-target={d.href}>{d.title}</a>
            </li>
          ))}
        </ul>
        <a href="/guides" class={`mt-3 inline-flex min-h-11 items-center font-medium ${link}`}>Guides from every country</a>
      </div>
    )}
  </section>

  <section class="pb-12" aria-labelledby="photos-heading">
    <div class="shell"><h2 id="photos-heading" class="font-display-tight text-2xl text-stone-900 sm:text-3xl">Solar in the real world</h2></div>
    <div class="shell"><ul class="scrollbar-none mt-4 flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2" tabindex="0" aria-label="Photos of solar installations, scroll sideways">
      {photos.map((ph) => (
        <li class="w-64 shrink-0 snap-start sm:w-80">
          <figure>
            <Image src={ph.src} alt={ph.alt} widths={[320, 640]} sizes="(min-width: 640px) 320px, 256px" width={640} height={420} loading="lazy" decoding="async" class="aspect-[4/3] w-full rounded-xl object-cover" />
            <figcaption class="mt-1.5 text-xs text-stone-700">{ph.credit}</figcaption>
          </figure>
        </li>
      ))}
    </ul></div>
    <p class="shell mt-2 text-xs text-stone-700">Photo sources are listed on the <a href="/credits" class={link}>credits page</a>.</p>
  </section>

  <section class="bg-ink-900 py-12 text-white" aria-labelledby="method-heading">
    <div class="shell grid items-center gap-8 lg:grid-cols-[auto_1fr]">
      <div class="flex items-center gap-4">
        <Ray pose="magnifier" size={120} class="shrink-0" />
        <h2 id="method-heading" class="font-display-tight max-w-xs text-3xl text-white">How we keep the numbers honest</h2>
      </div>
      <div>
        <ul class="grid gap-6 sm:grid-cols-3">
          {method.map((m) => (
            <li class="border-t-2 border-sun-400 pt-3">
              <h3 class="font-semibold text-white">{m.title}</h3>
              <p class="mt-1 leading-7 text-ink-100">{m.body}</p>
            </li>
          ))}
        </ul>
        <p class="mt-5 leading-7 text-ink-100">Read the <a href="/methodology" class="text-sun-300 underline underline-offset-2 hover:text-white focus-visible:outline-sun-300">methodology</a>. RayValue is an independent site, not a utility or a government agency; the <a href="/affiliate-disclosure" class="text-sun-300 underline underline-offset-2 hover:text-white focus-visible:outline-sun-300">affiliate disclosure</a> explains how it is funded.</p>
      </div>
    </div>
  </section>
</BaseLayout>
