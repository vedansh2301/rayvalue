---
<BaseLayout title="Photo credits" description="Sources and licenses for the photographs used on RayValue." path={path} noindex>
  <div class="page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Photo credits' }]} />
    <h1 class="!mt-4">Photo credits</h1>
    <p>
      These are the sources and licenses for the photographs on RayValue. Their use does not imply any endorsement by
      the photographers, the U.S. Department of Energy or any other agency.
    </p>
    <ul>
      {photos.map((p) => (
        <li>
          <strong>{p.use}.</strong> {p.desc} Photo by {p.credit}. {p.note}{' '}
          {p.licenseHref ? <a href={p.licenseHref} rel="license noopener noreferrer">{p.license}</a> : p.license}.{' '}
          <a href={p.href} rel="noopener noreferrer">Source</a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
