---
import { PAGE_META } from '../../lib/seo/page-meta';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { ogImagePath } from '../../lib/seo/og';
import QuoteForm from '../../components/quotes/QuoteForm';
import Icon, { type IconName } from '../../components/icons/Icon';
import { Picture } from 'astro:assets';
import quotesPhoto from '../../assets/photos/ca-rooftop-solar-install.jpg';
import Faq from '../../components/Faq.astro';
import { QUOTES_FAQ_IDS, faqItems } from '../../lib/content/faq';
import { faqJsonLd } from '../../lib/seo/jsonld';

const faq = faqItems(QUOTES_FAQ_IDS);
// Static shell; the form is a small island. ?state=FL|CA, ?zip= and ?source= prefill it (read in the browser).
const trust: { icon: IconName; text: string }[] = [
  { icon: 'shield', text: 'No obligation' },
  { icon: 'users', text: 'Up to 3 local installers' },
  { icon: 'lock', text: 'Shared only with the installers you agree to hear from' },
];
const steps: { icon: IconName; short: string; long: string }[] = [
  { icon: 'home', short: 'Tell us about your home', long: 'Tell us about your home' },
  { icon: 'users', short: 'Up to 3 installers reach out', long: 'Up to 3 local installers reach out' },
  { icon: 'scale', short: 'Compare and choose', long: 'Compare and choose' },
];
---
<BaseLayout
  title={PAGE_META.quotes.title}
  description={PAGE_META.quotes.description}
  path="/quotes"
  ogImagePath={ogImagePath('quotes')}
  jsonLd={[faqJsonLd(faq)]}
>
  <div class="shell pb-16 pt-8 sm:pt-10">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Get quotes' }]} />
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:mt-6 sm:text-4xl">Get free solar quotes</h1>
    <p class="mt-2 text-lg text-stone-700 sm:hidden">Takes about a minute. Free, no obligation.</p>
    <div class="mt-6 grid gap-6 lg:grid-cols-[2fr_3fr] lg:items-start lg:gap-10">
      <aside aria-label="How quotes work" class="order-last lg:order-none lg:sticky lg:top-6">
        <div class="hidden lg:block">
          <Picture
            src={quotesPhoto}
            formats={['avif', 'webp']}
            widths={[400, 640]}
            sizes="360px"
            alt="Installers in hard hats lifting a solar panel into place on a shingle roof in California"
            width={640}
            height={480}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full rounded-xl object-cover"
          />
        </div>
        <ol class="hidden grid-cols-3 gap-2 sm:grid lg:mt-6 lg:grid-cols-1 lg:gap-4">
          {steps.map((st, i) => (
            <li class="flex flex-col items-center gap-2 rounded-xl border border-stone-200 bg-white p-3 text-center lg:flex-row lg:gap-4 lg:p-4 lg:text-left">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sun-100 text-stone-900"><Icon name={st.icon} /></span>
              <span class="text-sm font-medium leading-5 text-stone-900 lg:text-base"><span class="sr-only">Step {i + 1}: </span><span class="hidden lg:inline">{i + 1}. </span>{st.long}</span>
            </li>
          ))}
        </ol>
        <ul class="mt-4 space-y-2 text-sm text-stone-800" aria-label="Why use RayValue">
          {trust.map((t) => (
            <li class="flex items-center gap-2"><Icon name={t.icon} size={20} class="text-stone-900" />{t.text}</li>
          ))}
        </ul>
      </aside>
      <!-- owner: legal review of consent before paid traffic -->
      <section aria-label="Quote request" class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-8">
        <QuoteForm client:visible id="quotes" source="quotes_page" pagePath="/quotes" fromQuery />
      </section>
    </div>
    <div class="max-w-(--container-prose)">
      <p class="mt-6 text-stone-700">
        Want a number first? Try the <a href="/calculator/florida" class="text-sun-ink underline underline-offset-2 hover:text-stone-900">Florida</a> or{" "}
        <a href="/calculator/california" class="text-sun-ink underline underline-offset-2 hover:text-stone-900">California</a> payback calculator.
      </p>
      <div class="mt-12">
        <Faq items={faq} id="quotes-faq" />
      </div>
    </div>
  </div>
</BaseLayout>
