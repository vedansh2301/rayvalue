---
/**
 * Australian solar + battery payback calculator: /au/solar-battery-calculator. Values are read from the database at request
 * time (CDN-cached ~5 min) and passed to the shared calculator island as props. If any of it cannot be loaded or is invalid
 * the page still renders (HTTP 200) with a "verifying" message and a short cache. No lead form: leads are US-only. The
 * affiliate slot renders only when an active offer is set up for country AU. Hidden (noindex, out of the sitemap) until the
 * owner reviews the AU data and publishes the market.
 */
export const prerender = false;

import CalcShell from '../../components/calculator/CalcShell.astro';
import { rebateStepDownDays } from '../../lib/calculator/design';
import OfferSlot from '../../components/OfferSlot.astro';
import CalculatorIntl from '../../components/calculator/CalculatorIntl';
import { offersForCountry } from '../../lib/offers/load';
import { loadCalculatorPageData } from '../../lib/calculator/uk-page-data';
import { DB_PAGE_CACHE_HEADERS } from '../../lib/db/repo';
import { DB_ERROR_CACHE_HEADERS } from '../../lib/calculator/page-data';

const path = '/au/solar-battery-calculator';
const data = await loadCalculatorPageData('AU', new Date().toISOString().slice(0, 10));
for (const [k, v] of Object.entries(data.ok ? DB_PAGE_CACHE_HEADERS : DB_ERROR_CACHE_HEADERS)) Astro.response.headers.set(k, v);
if (!data.ok) console.error('au calculator: data unavailable:', data.error.kind, data.error.message, data.error.issues ?? '');
const offers = data.ok ? await offersForCountry('AU') : [];
// Indexable only once the owner publishes the AU market (CLAUDE.md rule 9 spirit: nothing new is public before review).
const indexable = data.ok && data.props.market.published;
const steps = [
  'You pick your electricity network, say how much electricity you use, which way the roof faces and how much shade it gets.',
  'We look up how much sun a rooftop array gets near your network using the European Commission’s PVGIS solar model, assuming north-facing panels at the best tilt, then adjust for your roof direction and shade.',
  'We work backwards from your bill, using the regulated flat tariff for your network (the Default Market Offer cap or the state-regulated tariff), to estimate how much electricity you use in a year, then size a system to cover most of it.',
  'We price the system from published installer price guides (secondary sources: SolarQuotes for solar, CHOICE for batteries). A battery is priced before the federal Cheaper Home Batteries rebate, which we then deduct using the rebate factor for the install date and the Clean Energy Regulator’s STC price.',
  'We value the solar you use at home at your usage rate and the solar you export at the feed-in rate you chose, and project savings over 25 years with a range of price rises.',
  'We show low, likely and high results, with every assumption and source listed.',
];
const nRegions = data.ok ? data.props.utilities.length : null;
const rebateDays = data.ok ? rebateStepDownDays(data.props.incentives, data.props.today) : null;
const reads = [
  { collection: 'guides', id: 'au/battery-rebate-changes-2027' },
  { collection: 'guides', id: 'au/battery-rebate-scams' },
  { collection: 'guides', id: 'au/when-solar-doesnt-pay-off-australia' },
  { collection: 'blog', id: 'au/is-solar-still-worth-it-low-feed-in-tariffs' },
] as const;
---
<CalcShell
  seg="au" lang="en-AU" path={path} noindex={!indexable}
  metaTitle="Australian solar and battery payback calculator"
  metaDescription="Estimate solar and battery cost, savings and payback for your Australian home as low, likely and high ranges, with the Default Market Offer, state feed-in rates and the federal battery rebate step-down on 1 January 2027."
  h1="Australian solar and battery payback calculator"
  sub="Low, likely and high ranges from your network’s regulated prices, your feed-in rate and the federal battery rebate, which steps down on 1 January 2027."
  startLabel="Start · 6 quick questions"
  chip={rebateDays !== null ? { label: `Battery rebate steps down in ${rebateDays} ${rebateDays === 1 ? 'day' : 'days'}`, href: '/au/guides/battery-rebate-changes-2027' } : null}
  checks={['Default Market Offer prices', 'State feed-in rates', 'Federal battery rebate']}
  heroPhotoId="d-au-opera-house"
  badge={nRegions ? { title: `${nRegions} electricity networks`, sub: 'Regulated prices by network' } : null}
  howHeading="How we calculated this" readsHeading="Read before you buy in Australia" readsAll={{ href: '/au/blog', label: 'All Australian posts' }} readLabel="Read"
  picks={[...reads]}
>
  {data.ok ? (
    <CalculatorIntl client:visible {...data.props} />
  ) : (
    <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm sm:p-8">
      <h2 class="text-xl font-semibold text-stone-900">We&rsquo;re verifying the data for this calculator</h2>
      <p class="mt-2 leading-7 text-stone-700">The Australian calculator is temporarily unavailable while we check our price, tariff and cost data. Please try again soon.</p>
    </div>
  )}
  <div slot="after"><OfferSlot offers={offers} pagePath={path} heading="Offers for Australian homes" /></div>
  <Fragment slot="how">
    <ol class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {steps.map((st, i) => (
        <li class="flex flex-col gap-2 rounded-[18px] border border-sky-pastel-300 bg-white p-[18px]">
          <span class="font-display-tight text-[28px] text-sky-pastel-600" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <p class="text-[15px] leading-relaxed text-stone-800">{st}</p>
        </li>
      ))}
    </ol>
    <p class="mt-6 text-stone-700">
            Installed prices are the weakest part of this estimate: no official Australian price statistic was found, so the cost range comes from secondary sources and is indicative. Victoria is not covered yet because the regulator publishes only annual bills, not the unit rate we need. Time-of-use and evening feed-in rates are not modelled.
          </p>
    <p class="mt-6 text-stone-700">
            Every source and assumption is explained in our <a href="/methodology" class="text-sun-ink underline underline-offset-2 hover:text-stone-900">methodology</a>. Estimates are not a quote; installer prices and your actual usage will differ.
          </p>
  </Fragment>
</CalcShell>
