---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
import { adminSelect, adminSelectAll } from '../../lib/server/admin-db';
import { adminEnv, adminPrelude } from '../../lib/server/social-page';
import { summariseByCountry, total, type FactStat, type SourceStat } from '../../lib/scrape/admin-report';

// Owner-only, read-only view of the scraper pipeline. Same Basic auth as the other admin pages. No personal data.
export const prerender = false;
const env = adminEnv();
const denied = await adminPrelude(Astro, env);
if (denied) return denied;

interface ChangedFact { country: string; key: string; region: string; value: string | null; unit: string | null; previous_value: string | null; source_url: string; check_note: string | null; checked_at: string | null }
interface NewsRow { country: string; title: string; url: string; published_at: string | null; topics: string[]; relevance: number }

const [sources, facts, changed, news] = await Promise.all([
  adminSelectAll<SourceStat>(env, 'sources', { select: 'country,last_status,last_fetched_at,consecutive_failures', order: 'id' }, fetch, 20),
  adminSelectAll<FactStat>(env, 'facts_staging', { select: 'country,status', order: 'id' }, fetch, 40),
  adminSelect<ChangedFact>(env, 'facts_staging', { select: 'country,key,region,value,unit,previous_value,source_url,check_note,checked_at', status: 'eq.changed', order: 'checked_at.desc.nullslast', limit: '100' }, fetch),
  adminSelect<NewsRow>(env, 'news_items', { select: 'country,title,url,published_at,topics,relevance', order: 'published_at.desc.nullslast', limit: '40' }, fetch),
]);
const ok = sources !== null && facts !== null;
const rows = ok ? summariseByCountry(sources, facts) : [];
const all = total(rows);
const th = 'px-2 py-2 text-left font-semibold';
const td = 'px-2 py-2 align-top';
const safeHref = (u: string) => (/^https?:\/\//.test(u) ? u : '#');
---
<BaseLayout title="Sources" description="Owner-only scraper status." path="/admin/sources" noindex>
  <div class="shell py-8">
    <AdminNav current="/admin/sources" />
    <h1 class="mt-4 text-2xl font-bold text-stone-900">Sources and staged facts</h1>
    <p class="mt-1 text-sm text-stone-700">Read-only. Scraped values never reach public pages: a person promotes a confirmed fact after review.</p>

    {!ok && <p role="status" class="mt-6 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-stone-900">Could not read the scraper tables. Apply migrations 0030 and 0031 and run the importer.</p>}

    {ok && (
      <>
        <section aria-labelledby="countries" class="mt-6">
          <h2 id="countries" class="text-lg font-semibold text-stone-900">By country</h2>
          <div class="mt-2 overflow-x-auto">
            <table class="w-full min-w-[40rem] border-collapse text-sm text-stone-900">
              <caption class="sr-only">Sources and staged facts per country</caption>
              <thead class="bg-stone-100"><tr><th scope="col" class={th}>Country</th><th scope="col" class={th}>Sources</th><th scope="col" class={th}>Fetched</th><th scope="col" class={th}>Failing</th><th scope="col" class={th}>Blocked</th><th scope="col" class={th}>Facts</th><th scope="col" class={th}>Confirmed</th><th scope="col" class={th}>Changed</th></tr></thead>
              <tbody>
                {rows.map((r) => (
                  <tr class="border-t border-stone-200"><th scope="row" class={td + ' uppercase'}>{r.country}</th><td class={td}>{r.sources}</td><td class={td}>{r.fetched}</td><td class={td}>{r.failing}</td><td class={td}>{r.blocked}</td><td class={td}>{r.facts}</td><td class={td}>{r.confirmed}</td><td class={td + (r.changed ? ' font-semibold text-amber-900' : '')}>{r.changed}</td></tr>
                ))}
              </tbody>
              <tfoot><tr class="border-t-2 border-stone-300 font-semibold"><th scope="row" class={td}>All</th><td class={td}>{all.sources}</td><td class={td}>{all.fetched}</td><td class={td}>{all.failing}</td><td class={td}>{all.blocked}</td><td class={td}>{all.facts}</td><td class={td}>{all.confirmed}</td><td class={td}>{all.changed}</td></tr></tfoot>
            </table>
          </div>
        </section>

        <section aria-labelledby="changed" class="mt-8">
          <h2 id="changed" class="text-lg font-semibold text-stone-900">Changed facts awaiting review ({changed?.length ?? 0}{(changed?.length ?? 0) >= 100 ? '+' : ''})</h2>
          {(changed ?? []).length === 0 && <p class="mt-2 text-sm text-stone-700">Nothing flagged.</p>}
          <ul class="mt-2 space-y-2">
            {(changed ?? []).map((f) => (
              <li class="rounded-lg border border-stone-200 bg-white p-3 text-sm text-stone-900">
                <p><span class="font-semibold uppercase">{f.country}</span> · <code>{f.key}</code>{f.region && <> · {f.region}</>}: <strong>{f.value ?? 'no value'}</strong>{f.unit && <> {f.unit}</>}{f.previous_value !== null && <> (was {f.previous_value})</>}</p>
                {f.check_note && <p class="mt-1 text-stone-700">{f.check_note}</p>}
                <p class="mt-1"><a class="underline underline-offset-2" href={safeHref(f.source_url)} rel="noopener noreferrer" target="_blank">Source page</a></p>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="news" class="mt-8">
          <h2 id="news" class="text-lg font-semibold text-stone-900">Latest news</h2>
          {(news ?? []).length === 0 && <p class="mt-2 text-sm text-stone-700">No relevant feed items yet.</p>}
          <ul class="mt-2 space-y-2">
            {(news ?? []).map((n) => (
              <li class="text-sm text-stone-900"><span class="font-semibold uppercase">{n.country}</span> · {n.published_at?.slice(0, 10) ?? 'undated'} · <a class="underline underline-offset-2" href={safeHref(n.url)} rel="noopener noreferrer" target="_blank">{n.title}</a> <span class="text-stone-700">({n.topics.join(', ')})</span></li>
            ))}
          </ul>
        </section>
      </>
    )}
  </div>
</BaseLayout>
