---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminNav from '../../../components/admin/AdminNav.astro';
import { CHANNEL_CHIP, CHANNEL_LABEL, channelResults } from '../../../lib/social/channels';
import { strictSameOrigin } from '../../../lib/admin/auth';
import { flashText } from '../../../lib/social/flash';
import { parseGenerateTarget, parseListFilters } from '../../../lib/social/forms';
import { formatInZone } from '../../../lib/social/schedule';
import { STATUS_LABEL } from '../../../lib/social/status';
import { TEMPLATE_KEYS, templateByKey } from '../../../lib/social/template-keys';
import { CHANNELS, POST_STATUSES, POST_TYPES } from '../../../lib/social/types';
import { STATUS_CHIP, buildMonthGrid, monthLabel, parseMonth, shiftMonth } from '../../../lib/social/view';
import { UTILITY_PAGES } from '../../../lib/utility/pages';
import { adminEnv, adminPrelude, forbidden, redirectTo } from '../../../lib/server/social-page';
import { calendarPosts, dispatchRender, getSettings, listPosts, setPaused } from '../../../lib/server/social-admin';

// Owner-only post list and calendar. Basic auth (ADMIN_PASSWORD); noindex.
export const prerender = false;
const env = adminEnv();
const denied = await adminPrelude(Astro, env);
if (denied) return denied;

let error: string | null = null;
if (Astro.request.method === 'POST') {
  if (!strictSameOrigin(Astro.request)) return forbidden();
  const form = new URLSearchParams(await Astro.request.text());
  const action = form.get('action');
  if (action === 'pause' || action === 'resume') {
    const ok = await setPaused(env, action === 'pause');
    if (ok) return redirectTo(`/admin/social?ok=${action === 'pause' ? 'paused' : 'resumed'}`);
    error = 'Could not change the pause setting. Try again.';
  } else if (action === 'generate') {
    const tpl = templateByKey(form.get('template') ?? '');
    if (!tpl) error = 'Choose a template.';
    else {
      const target = parseGenerateTarget(tpl.target, form.get('target'), UTILITY_PAGES.map((u) => u.slug));
      if (!target.ok) error = target.errors[0]!;
      else {
        const r = await dispatchRender(env, tpl.key, target.value);
        if (r === 'ok') return redirectTo('/admin/social?ok=rendering');
        if (r === 'no_token') return redirectTo('/admin/social?ok=no_token');
        error = 'GitHub did not accept the request. Check GITHUB_DISPATCH_TOKEN and that the social-render workflow exists on main.';
      }
    }
  } else error = 'Unknown action.';
}

const url = new URL(Astro.request.url);
const ok = flashText(url.searchParams.get('ok'));
const settings = await getSettings(env);
const tz = settings?.timezone ?? 'America/New_York';
const view = url.searchParams.get('view') === 'calendar' ? 'calendar' : 'list';
const filters = parseListFilters(url.searchParams);
const now = new Date();

const posts = view === 'list' ? await listPosts(env, filters) : null;
const month = parseMonth(url.searchParams.get('month'), now, tz);
const grid = view === 'calendar' ? buildMonthGrid(month, tz, (await calendarPosts(env)) ?? []) : [];
const failedChecks = (p: { checks: { ok: boolean; level: string }[] }) => p.checks.filter((c) => !c.ok && c.level === 'error').length;
const input = 'min-h-11 rounded border border-stone-400 bg-white px-3 py-2 text-stone-900';
const btn = 'inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-2 font-semibold';
---
<BaseLayout title="Social posts" description="Owner-only social media manager." path="/admin/social" noindex>
  <div class="shell py-8">
    <AdminNav current="/admin/social" />
    <h1 class="mt-4 text-2xl font-bold text-stone-900">Social posts</h1>

    {ok && <p role="status" class="mt-4 rounded-lg border border-green-300 bg-green-50 px-4 py-3 text-stone-900">{ok}</p>}
    {error && <p role="alert" class="mt-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-stone-900">{error}</p>}
    {settings === null && <p role="alert" class="mt-4 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-stone-900">Could not read settings from the database.</p>}

    {settings && (
      <section aria-label="Posting status" class={`mt-4 flex flex-col gap-3 rounded-lg border p-4 sm:flex-row sm:items-center sm:justify-between ${settings.paused ? 'border-amber-400 bg-amber-100' : 'border-stone-200 bg-white'}`}>
        <div>
          <p class="font-semibold text-stone-900">{settings.paused ? 'Posting is PAUSED. Nothing will publish.' : 'Posting is on.'}</p>
          <p class="text-sm text-stone-800">
            Auto-publish: <strong>{settings.auto_publish ? 'on' : 'off'}</strong>
            {settings.auto_publish ? ' (posts that pass every check go out at their time)' : ' (posts you schedule yourself still go out)'}.
            Times shown in {tz}. <a href="/admin/social/settings" class="underline underline-offset-2">Settings</a>
          </p>
        </div>
        <form method="post" action="/admin/social">
          <input type="hidden" name="action" value={settings.paused ? 'resume' : 'pause'} />
          <button type="submit" class={`${btn} ${settings.paused ? 'bg-sun-400 text-stone-900 hover:bg-sun-500' : 'bg-red-700 text-white hover:bg-red-800'}`}>{settings.paused ? 'Resume posting' : 'Pause all posting'}</button>
        </form>
      </section>
    )}

    <div class="mt-6 flex flex-wrap items-center gap-2">
      <a href="/admin/social/new" class={`${btn} bg-sun-400 text-stone-900 hover:bg-sun-500`}>New post</a>
      <nav aria-label="View" class="flex gap-1">
        <a href="/admin/social" aria-current={view === 'list' ? 'page' : undefined} class:list={['inline-flex min-h-11 items-center rounded border px-3 text-sm', view === 'list' ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300']}>List</a>
        <a href="/admin/social?view=calendar" aria-current={view === 'calendar' ? 'page' : undefined} class:list={['inline-flex min-h-11 items-center rounded border px-3 text-sm', view === 'calendar' ? 'border-stone-900 bg-stone-900 text-white' : 'border-stone-300']}>Calendar</a>
      </nav>
    </div>

    {view === 'list' && (
      <>
        <form method="get" action="/admin/social" class="mt-4 flex flex-wrap items-end gap-3" role="search" aria-label="Filter posts">
          <div class="flex flex-col gap-1">
            <label for="f-status" class="text-sm font-medium text-stone-800">Status</label>
            <select id="f-status" name="status" class={input}>
              <option value="">All</option>
              {POST_STATUSES.map((s) => <option value={s} selected={filters.status === s}>{STATUS_LABEL[s]}</option>)}
            </select>
          </div>
          <div class="flex flex-col gap-1">
            <label for="f-type" class="text-sm font-medium text-stone-800">Type</label>
            <select id="f-type" name="type" class={input}>
              <option value="">All</option>
              {POST_TYPES.map((t) => <option value={t} selected={filters.type === t}>{t}</option>)}
            </select>
          </div>
          <div class="flex flex-col gap-1">
            <label for="f-channel" class="text-sm font-medium text-stone-800">Channel</label>
            <select id="f-channel" name="channel" class={input}>
              <option value="">All</option>
              {CHANNELS.map((c) => <option value={c} selected={filters.channel === c}>{CHANNEL_LABEL[c]}</option>)}
            </select>
          </div>
          <div class="flex min-w-48 flex-1 flex-col gap-1">
            <label for="f-q" class="text-sm font-medium text-stone-800">Search title or caption</label>
            <input id="f-q" name="q" value={filters.q} maxlength="80" class={input} />
          </div>
          <button type="submit" class={`${btn} bg-stone-900 text-white hover:bg-stone-700`}>Filter</button>
          {(filters.status || filters.type || filters.channel || filters.q) && <a href="/admin/social" class="inline-flex min-h-11 items-center px-2 underline underline-offset-2">Clear</a>}
        </form>

        {posts === null && <p class="mt-6 text-stone-900">Could not read posts from the database.</p>}
        {posts !== null && posts.length === 0 && <p class="mt-6 text-stone-700">No posts match. <a href="/admin/social/new" class="underline underline-offset-2">Create one</a>.</p>}
        {posts !== null && posts.length > 0 && (
          <ul class="mt-6 space-y-3" aria-label="Posts, most recently updated first">
            {posts.map((p) => {
              const bad = failedChecks(p);
              return (
                <li class="rounded-lg border border-stone-200 bg-white p-4">
                  <div class="flex flex-wrap items-center gap-2">
                    <a href={`/admin/social/${p.id}`} class="text-lg font-semibold text-stone-900 underline-offset-2 hover:underline">{p.title || '(untitled)'}</a>
                    <span class={`rounded-full border px-2 py-0.5 text-xs font-semibold ${STATUS_CHIP[p.status]}`}>{STATUS_LABEL[p.status]}</span>
                    <span class="rounded-full border border-stone-300 px-2 py-0.5 text-xs text-stone-800">{p.type}</span>
                    {p.origin === 'generated' && <span class="rounded-full border border-stone-300 px-2 py-0.5 text-xs text-stone-800">generated</span>}
                  </div>
                  <p class="mt-1 line-clamp-2 text-sm text-stone-700">{p.caption || 'No caption'}</p>
                  <p class="mt-2 text-sm text-stone-800">
                    {p.scheduled_at && p.status !== 'published' && <span>Due {formatInZone(p.scheduled_at, tz)}. </span>}
                    {p.published_at && <span>Published {formatInZone(p.published_at, tz)}. </span>}
                    <span class={bad ? 'font-semibold text-red-800' : 'text-green-800'}>{bad ? `${bad} check${bad === 1 ? '' : 's'} failing` : p.checks.length ? 'Checks pass' : 'Not checked yet'}</span>
                  </p>
                  <ul class="mt-2 flex flex-wrap gap-2 text-sm" aria-label="Result per channel">
                    {channelResults(p, { selectedOnly: true }).map((r) => (
                      <li class="rounded border border-stone-200 px-2 py-1 text-stone-900">
                        <span class="font-medium">{r.label}</span>{' '}
                        <span class={`rounded-full border px-2 py-0.5 text-xs font-semibold ${CHANNEL_CHIP[r.state]}`}>{r.text}</span>
                        {r.permalink && <> · <a href={r.permalink} rel="noopener noreferrer" class="underline underline-offset-2">View<span class="sr-only"> on {r.label}</span></a></>}
                        {r.error && <span class="block text-red-800">Error: {r.error}</span>}
                      </li>
                    ))}
                  </ul>
                </li>
              );
            })}
          </ul>
        )}
      </>
    )}

    {view === 'calendar' && (
      <section aria-labelledby="cal-h" class="mt-6">
        <div class="flex items-center justify-between gap-2">
          <a href={`/admin/social?view=calendar&month=${shiftMonth(month, -1)}`} class="inline-flex min-h-11 items-center rounded border border-stone-300 px-3">Previous<span class="sr-only"> month</span></a>
          <h2 id="cal-h" class="text-lg font-semibold text-stone-900">{monthLabel(month)}</h2>
          <a href={`/admin/social?view=calendar&month=${shiftMonth(month, 1)}`} class="inline-flex min-h-11 items-center rounded border border-stone-300 px-3">Next<span class="sr-only"> month</span></a>
        </div>
        <p class="mt-1 text-sm text-stone-700">Scheduled and published posts, by day in {tz}.</p>
        <div class="mt-3 overflow-x-auto" role="region" aria-label="Calendar" tabindex="0">
          <table class="w-full min-w-[42rem] table-fixed border-collapse text-sm">
            <caption class="sr-only">{monthLabel(month)}</caption>
            <thead>
              <tr>{['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((d) => <th scope="col" class="border border-stone-300 bg-stone-100 px-1 py-1 text-left font-medium text-stone-800">{d}</th>)}</tr>
            </thead>
            <tbody>
              {grid.map((week) => (
                <tr>
                  {week.map((cell) => (
                    <td class:list={['h-24 border border-stone-300 p-1 align-top', cell.inMonth ? 'bg-white' : 'bg-stone-100 text-stone-500']}>
                      <span class="text-xs font-semibold">{cell.day}<span class="sr-only"> {cell.date}</span></span>
                      <ul class="mt-1 space-y-1">
                        {cell.posts.map(({ post, at }) => (
                          <li>
                            <a href={`/admin/social/${post.id}`} class={`block truncate rounded border px-1 py-0.5 text-xs ${STATUS_CHIP[post.status]}`}>
                              <span class="font-semibold">{new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit' }).format(new Date(at))}</span> {post.title || post.type}
                              <span class="sr-only"> ({STATUS_LABEL[post.status]}, {post.type})</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section aria-labelledby="gen-h" class="mt-10 rounded-lg border border-stone-200 bg-white p-4">
      <h2 id="gen-h" class="text-lg font-semibold text-stone-900">Generate a post</h2>
      <p class="mt-1 text-sm text-stone-700">Renders a data-driven Reel or carousel from the database (a GitHub Actions job). The finished post appears here as a draft or scheduled post within a few minutes.</p>
      <form method="post" action="/admin/social" class="mt-3 flex flex-wrap items-end gap-3">
        <input type="hidden" name="action" value="generate" />
        <div class="flex flex-col gap-1">
          <label for="g-template" class="text-sm font-medium text-stone-800">Template</label>
          <select id="g-template" name="template" required class={input}>
            {TEMPLATE_KEYS.map((t) => <option value={t.key}>{t.label}</option>)}
          </select>
        </div>
        <div class="flex flex-col gap-1">
          <label for="g-target" class="text-sm font-medium text-stone-800">Utility or state</label>
          <select id="g-target" name="target" class={input}>
            <optgroup label="Utilities">
              {UTILITY_PAGES.map((u) => <option value={u.slug}>{u.short} ({u.state})</option>)}
            </optgroup>
            <optgroup label="States">
              <option value="fl">Florida</option>
              <option value="ca">California</option>
            </optgroup>
          </select>
        </div>
        <button type="submit" class={`${btn} bg-stone-900 text-white hover:bg-stone-700`}>Generate</button>
      </form>
      <p class="mt-2 text-sm text-stone-700">Utility templates need a utility; state templates need Florida or California.</p>
    </section>
  </div>
</BaseLayout>
