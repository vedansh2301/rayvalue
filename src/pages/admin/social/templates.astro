---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminNav from '../../../components/admin/AdminNav.astro';
import { strictSameOrigin } from '../../../lib/admin/auth';
import { LIMITS, isUuid, parseTemplateForm } from '../../../lib/social/forms';
import { adminEnv, adminPrelude, forbidden } from '../../../lib/server/social-page';
import { deleteTemplate, listTemplates, saveTemplate } from '../../../lib/server/social-admin';

export const prerender = false;
const env = adminEnv();
const denied = await adminPrelude(Astro, env);
if (denied) return denied;

let flash: { ok: boolean; text: string } | null = null;
if (Astro.request.method === 'POST') {
  if (!strictSameOrigin(Astro.request)) return forbidden();
  const form = new URLSearchParams(await Astro.request.text());
  const action = form.get('action');
  const id = form.get('id');
  if (action === 'delete') {
    if (!isUuid(id)) flash = { ok: false, text: 'Invalid template.' };
    else flash = (await deleteTemplate(env, id)) ? { ok: true, text: 'Template deleted.' } : { ok: false, text: 'Could not delete the template.' };
  } else if (action === 'save') {
    const parsed = parseTemplateForm(form);
    if (!parsed.ok) flash = { ok: false, text: parsed.errors[0]! };
    else if (id && !isUuid(id)) flash = { ok: false, text: 'Invalid template.' };
    else {
      const r = await saveTemplate(env, id || null, parsed.value);
      flash = r === 'ok' ? { ok: true, text: 'Template saved.' } : r === 'duplicate' ? { ok: false, text: 'A template with that kind and name already exists.' } : { ok: false, text: 'Could not save the template.' };
    }
  } else flash = { ok: false, text: 'Unknown action.' };
}

const templates = await listTemplates(env);
const groups = [
  { kind: 'caption', title: 'Caption templates', hint: 'Reusable caption text. Avoid numbers here: the number check will flag any figure that is not traced to the database.' },
  { kind: 'hashtags', title: 'Hashtag sets', hint: 'Instagram allows at most 30 hashtags per post.' },
] as const;
const input = 'w-full rounded border border-stone-400 bg-white px-3 py-2 text-stone-900';
const btn = 'inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-2 font-semibold';
---
<BaseLayout title="Social templates" description="Owner-only caption templates." path="/admin/social/templates" noindex>
  <div class="shell py-8">
    <AdminNav current="/admin/social/templates" />
    <h1 class="mt-4 text-2xl font-bold text-stone-900">Caption templates and hashtag sets</h1>
    <p class="mt-1 text-sm text-stone-700">Insert these into a caption from the post editor.</p>

    {flash && <p role={flash.ok ? 'status' : 'alert'} class={`mt-4 rounded-lg border px-4 py-3 text-stone-900 ${flash.ok ? 'border-green-300 bg-green-50' : 'border-amber-300 bg-amber-50'}`}>{flash.text}</p>}
    {templates === null && <p class="mt-4 text-stone-900">Could not read templates from the database.</p>}

    {groups.map((g) => (
      <section aria-labelledby={`h-${g.kind}`} class="mt-8">
        <h2 id={`h-${g.kind}`} class="text-lg font-semibold text-stone-900">{g.title}</h2>
        <p class="text-sm text-stone-700">{g.hint}</p>
        <ul class="mt-3 space-y-3">
          {(templates ?? []).filter((t) => t.kind === g.kind).map((t) => (
            <li class="rounded-lg border border-stone-200 bg-white p-4">
              <form method="post" action="/admin/social/templates" class="space-y-2">
                <input type="hidden" name="id" value={t.id} />
                <input type="hidden" name="kind" value={t.kind} />
                <div>
                  <label for={`n-${t.id}`} class="text-sm font-medium text-stone-800">Name</label>
                  <input id={`n-${t.id}`} name="name" required maxlength={LIMITS.templateName} value={t.name} class={input} />
                </div>
                <div>
                  <label for={`b-${t.id}`} class="text-sm font-medium text-stone-800">Text</label>
                  <textarea id={`b-${t.id}`} name="body" required rows="4" maxlength={LIMITS.templateBody} class={input}>{t.body}</textarea>
                </div>
                <div class="flex flex-wrap gap-2">
                  <button type="submit" name="action" value="save" class={`${btn} bg-stone-900 text-white hover:bg-stone-700`}>Save</button>
                  <button type="submit" name="action" value="delete" class={`${btn} border border-red-700 bg-white text-red-800 hover:bg-red-50`}>Delete<span class="sr-only"> {t.name}</span></button>
                </div>
              </form>
            </li>
          ))}
          {templates !== null && !templates.some((t) => t.kind === g.kind) && <li class="text-stone-700">None yet.</li>}
        </ul>
        <form method="post" action="/admin/social/templates" class="mt-3 space-y-2 rounded-lg border border-dashed border-stone-400 p-4">
          <input type="hidden" name="action" value="save" />
          <input type="hidden" name="kind" value={g.kind} />
          <h3 class="font-semibold text-stone-900">Add {g.kind === 'caption' ? 'a caption template' : 'a hashtag set'}</h3>
          <div>
            <label for={`new-n-${g.kind}`} class="text-sm font-medium text-stone-800">Name</label>
            <input id={`new-n-${g.kind}`} name="name" required maxlength={LIMITS.templateName} class={input} />
          </div>
          <div>
            <label for={`new-b-${g.kind}`} class="text-sm font-medium text-stone-800">Text</label>
            <textarea id={`new-b-${g.kind}`} name="body" required rows="4" maxlength={LIMITS.templateBody} class={input}></textarea>
          </div>
          <button type="submit" class={`${btn} bg-sun-400 text-stone-900 hover:bg-sun-500`}>Add</button>
        </form>
      </section>
    ))}
  </div>
</BaseLayout>
