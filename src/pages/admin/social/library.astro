---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdminNav from '../../../components/admin/AdminNav.astro';
import LibraryUpload from '../../../components/admin/LibraryUpload';
import { strictSameOrigin } from '../../../lib/admin/auth';
import { LIMITS, isUuid, parseMediaMeta } from '../../../lib/social/forms';
import { formatBytes } from '../../../lib/social/view';
import { adminEnv, adminPrelude, forbidden } from '../../../lib/server/social-page';
import { deleteMedia, listMedia, mediaUsage, updateMediaMeta } from '../../../lib/server/social-admin';

export const prerender = false;
const env = adminEnv();
const denied = await adminPrelude(Astro, env);
if (denied) return denied;

let flash: { ok: boolean; text: string } | null = null;
if (Astro.request.method === 'POST') {
  if (!strictSameOrigin(Astro.request)) return forbidden();
  const form = new URLSearchParams(await Astro.request.text());
  const action = form.get('action');
  if (action === 'update') {
    const parsed = parseMediaMeta(form);
    if (!parsed.ok) flash = { ok: false, text: parsed.errors[0]! };
    else flash = (await updateMediaMeta(env, parsed.value.id, parsed.value)) ? { ok: true, text: 'Media details saved.' } : { ok: false, text: 'Could not save. Try again.' };
  } else if (action === 'delete') {
    const id = form.get('id');
    if (!isUuid(id)) flash = { ok: false, text: 'Invalid media id.' };
    else {
      const r = await deleteMedia(env, id);
      flash = r.ok ? { ok: true, text: 'Media deleted.' } : { ok: false, text: r.error };
    }
  } else flash = { ok: false, text: 'Unknown action.' };
}

const [media, usage] = await Promise.all([listMedia(env), mediaUsage(env)]);
const input = 'w-full rounded border border-stone-400 bg-white px-2 py-2 text-stone-900';
---
<BaseLayout title="Social media library" description="Owner-only media library." path="/admin/social/library" noindex>
  <div class="shell py-8">
    <AdminNav current="/admin/social/library" />
    <h1 class="mt-4 text-2xl font-bold text-stone-900">Media library</h1>
    <p class="mt-1 text-sm text-stone-700">JPEG photos and MP4 or MOV videos, up to 50 MB each. Add a credit and license for anything RayValue did not make itself.</p>

    {flash && <p role={flash.ok ? 'status' : 'alert'} class={`mt-4 rounded-lg border px-4 py-3 text-stone-900 ${flash.ok ? 'border-green-300 bg-green-50' : 'border-amber-300 bg-amber-50'}`}>{flash.text}</p>}

    <div class="mt-6 max-w-2xl"><LibraryUpload client:load /></div>

    {media === null && <p class="mt-6 text-stone-900">Could not read the media library.</p>}
    {media !== null && media.length === 0 && <p class="mt-6 text-stone-700">No media yet.</p>}
    {media !== null && media.length > 0 && (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="Media">
        {media.map((m) => {
          const used = usage?.get(m.id) ?? 0;
          return (
            <li class="flex flex-col rounded-lg border border-stone-200 bg-white p-3">
              {m.kind === 'image' ? (
                <img src={m.public_url} alt={m.alt_text ?? ''} loading="lazy" class="aspect-video w-full rounded bg-stone-200 object-contain" />
              ) : (
                <video src={`${m.public_url}#t=0.1`} controls muted playsinline preload="none" aria-label={m.alt_text ?? 'Uploaded video'} class="aspect-video w-full rounded bg-black"></video>
              )}
              <p class="mt-2 text-sm text-stone-800">
                <strong>{m.kind}</strong> · {formatBytes(m.bytes)}
                {m.width && m.height ? ` · ${m.width}×${m.height}` : ''}
                {m.duration_s ? ` · ${m.duration_s}s` : ''}
                {m.source === 'generated' ? ' · generated' : ''}
              </p>
              <p class="text-sm text-stone-700">Used by {used} post{used === 1 ? '' : 's'}. {m.credit || m.license ? `Credit: ${m.credit ?? 'none'}; license: ${m.license ?? 'none'}.` : 'No credit or license recorded.'}</p>
              <form method="post" action="/admin/social/library" class="mt-2 space-y-2">
                <input type="hidden" name="id" value={m.id} />
                <div><label for={`a-${m.id}`} class="text-xs font-medium text-stone-800">Alt text</label><input id={`a-${m.id}`} name="alt_text" maxlength={LIMITS.alt} value={m.alt_text ?? ''} class={input} /></div>
                <div class="grid grid-cols-2 gap-2">
                  <div><label for={`c-${m.id}`} class="text-xs font-medium text-stone-800">Credit</label><input id={`c-${m.id}`} name="credit" maxlength={LIMITS.credit} value={m.credit ?? ''} class={input} /></div>
                  <div><label for={`l-${m.id}`} class="text-xs font-medium text-stone-800">License</label><input id={`l-${m.id}`} name="license" maxlength={LIMITS.license} value={m.license ?? ''} class={input} /></div>
                </div>
                <div class="flex flex-wrap gap-2">
                  <button type="submit" name="action" value="update" class="inline-flex min-h-11 items-center rounded-lg bg-stone-900 px-4 py-2 font-semibold text-white hover:bg-stone-700">Save</button>
                  {used === 0 ? (
                    <button type="submit" name="action" value="delete" class="inline-flex min-h-11 items-center rounded-lg border border-red-700 bg-white px-4 py-2 font-semibold text-red-800 hover:bg-red-50">Delete<span class="sr-only"> this {m.kind} permanently</span></button>
                  ) : (
                    <span class="inline-flex min-h-11 items-center text-sm text-stone-700">In use: cannot delete.</span>
                  )}
                </div>
              </form>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</BaseLayout>
