---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { publishedGuides } from '../../lib/guides';

const guides = (await publishedGuides()).sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());
// No published guides yet: a short "on the way" page, noindex (and out of the sitemap, see astro.config.mjs).
const empty = guides.length === 0;
---
<BaseLayout title="Solar and battery guides" description="Plain-language guides on solar and battery payback for Florida and California homeowners." path="/guides" noindex={empty}>
  <div class="page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Guides' }]} />
    <h1>Guides</h1>
    {empty ? (
      <p>Guides are on the way. Until then, the <a href="/calculator/florida">Florida calculator</a> and the <a href="/calculator/california">California calculator</a> show what solar and a battery could cost and save on your home.</p>
    ) : (
      <ul class="mt-4 space-y-4">
        {guides.map((g) => (
          <li>
            <a class="text-lg font-semibold underline underline-offset-4" href={`/guides/${g.id}`}>{g.data.title}</a>
            <p class="text-stone-700">{g.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
