---
import { PAGE_META } from '../../lib/seo/page-meta';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Index from '../../components/content/Index.astro';
import { publishedGuides } from '../../lib/guides';
import { displayDate } from '../../lib/dates';
import { coverTopic, readMinutes, stateKey } from '../../lib/content/cards';

const guides = (await publishedGuides()).sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());
// No published guides: a short pointer to the calculators, noindex (and out of the sitemap, see astro.config.mjs).
const empty = guides.length === 0;
const items = guides.map((g) => ({
  href: `/guides/${g.id}`,
  title: g.data.title,
  description: g.data.description,
  topic: coverTopic({ topic: g.data.topic, title: g.data.title, state: g.data.state }),
  state: stateKey(g.data.state),
  dateLabel: `Updated ${displayDate(g.data.updated)}`,
  datetime: g.data.updated.toISOString().slice(0, 10),
  readMin: readMinutes(g.body),
  cover: g.data.cover,
  coverAlt: g.data.coverAlt,
}));
---
<BaseLayout title={PAGE_META.guides.title} description={PAGE_META.guides.description} ogImagePath="/og/guides.png" path="/guides" noindex={empty}>
  {empty ? (
    <div class="page">
      <h1>Guides</h1>
      <p>To see what solar and a battery could cost and save on your home, use the <a href="/calculator/florida">Florida calculator</a> or the <a href="/calculator/california">California calculator</a>. The <a href="/methodology">methodology</a> page explains how the estimates are made.</p>
    </div>
  ) : (
    <Index kind="guides" heading="Guides" intro="In-depth guides to what solar and batteries cost, save and require now that the federal tax credit has ended." items={items} />
  )}
</BaseLayout>
