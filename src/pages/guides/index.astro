---
import { PAGE_META } from '../../lib/seo/page-meta';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { publishedGuides } from '../../lib/guides';

const guides = (await publishedGuides()).sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());
// No published guides: a short pointer to the calculators, noindex (and out of the sitemap, see astro.config.mjs).
const empty = guides.length === 0;
---
<BaseLayout title={PAGE_META.guides.title} description={PAGE_META.guides.description} ogImagePath="/og/guides.png" path="/guides" noindex={empty}>
  <div class="page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Guides' }]} />
    <h1>Guides</h1>
    {empty ? (
      <p>To see what solar and a battery could cost and save on your home, use the <a href="/calculator/florida">Florida calculator</a> or the <a href="/calculator/california">California calculator</a>. The <a href="/methodology">methodology</a> page explains how the estimates are made.</p>
    ) : (
      <ul class="mt-4 space-y-4">
        {guides.map((g) => (
          <li>
            <a class="text-lg font-semibold underline underline-offset-4" href={`/guides/${g.id}`}>{g.data.title}</a>
            <p class="text-stone-700">{g.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
