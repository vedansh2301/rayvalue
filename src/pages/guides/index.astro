---
import { PAGE_META } from '../../lib/seo/page-meta';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { publishedGuides } from '../../lib/guides';
import { displayDate } from '../../lib/dates';
import { stateTag } from '../../lib/content/tags';

const guides = (await publishedGuides()).sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());
// No published guides: a short pointer to the calculators, noindex (and out of the sitemap, see astro.config.mjs).
const empty = guides.length === 0;
---
<BaseLayout title={PAGE_META.guides.title} description={PAGE_META.guides.description} ogImagePath="/og/guides.png" path="/guides" noindex={empty}>
  <div class="page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Guides' }]} />
    <h1 class="mt-4">Guides</h1>
    <p class="mt-3 text-lg leading-8 text-stone-700">In-depth guides to what solar and batteries cost, save and require now that the federal tax credit has ended.</p>
    {empty ? (
      <p>To see what solar and a battery could cost and save on your home, use the <a href="/calculator/florida">Florida calculator</a> or the <a href="/calculator/california">California calculator</a>. The <a href="/methodology">methodology</a> page explains how the estimates are made.</p>
    ) : (
      <ul class="not-prose mt-8 grid gap-6 sm:grid-cols-2">
        {guides.map((g) => (
          <li class="relative flex flex-col rounded-xl border border-stone-200 bg-white p-5 shadow-sm focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-stone-900 hover:border-sun-400">
            <p class="text-xs font-medium uppercase tracking-wide text-stone-600">{stateTag(g.data.state)}</p>
            <h2 class="mt-2! text-lg font-semibold leading-snug text-stone-900"><a class="no-underline hover:underline underline-offset-4 after:absolute after:inset-0 focus-visible:outline-none" href={`/guides/${g.id}`}>{g.data.title}</a></h2>
            <p class="mt-2 leading-7 text-stone-700">{g.data.description}</p>
            <p class="mt-auto pt-3 text-sm text-stone-600">Updated <time datetime={g.data.updated.toISOString().slice(0, 10)}>{displayDate(g.data.updated)}</time></p>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
