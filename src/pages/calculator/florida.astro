---
import CalculatorPage from '../../components/calculator/CalculatorPage.astro';
import { applyCalculatorPageHeaders, loadCalculatorPageData } from '../../lib/calculator/page-data';

// On demand: calculator values are read from the database at request time (CDN-cached ~5 min).
export const prerender = false;

const data = await loadCalculatorPageData('FL');
applyCalculatorPageHeaders(Astro.response.headers, data, 'FL');
---
<CalculatorPage state="FL" data={data} />
