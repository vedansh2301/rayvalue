---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../lib/contact';
import { UNREVIEWED_PAGES } from '../lib/seo/unreviewed-pages';

const path = '/contact';
---
<BaseLayout title="Contact" description="Contact RayValue." path={path} noindex={UNREVIEWED_PAGES.has(path)}>
  <div class="page">
    <!-- TODO: owner copy -->
    <h1>Contact</h1>
    {CONTACT_EMAIL ? (
      <p>Email us at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
    ) : (
      <p>A contact email address is coming soon.</p>
    )}
  </div>
</BaseLayout>
