---
import BaseLayout from '../layouts/BaseLayout.astro';

---
<BaseLayout title="Page not found" description="That page does not exist. Try the solar payback calculators." path="/404" noindex canonical={false}>
  <section class="shell py-16">
    <div class="max-w-(--container-prose)">
    <h1 class="text-3xl font-bold text-stone-900">Page not found</h1>
    <p class="mt-3 text-stone-700">We could not find that page. These might help:</p>
    <ul class="mt-6 space-y-3 text-lg">
      <li><a class="font-medium text-amber-800 underline" href="/">Home</a></li>
      <li><a class="font-medium text-amber-800 underline" href="/calculator/florida">Florida solar + battery calculator</a></li>
      <li><a class="font-medium text-amber-800 underline" href="/calculator/california">California solar + battery calculator</a></li>
      <li><a class="font-medium text-amber-800 underline" href="/guides">Guides</a></li>
      <li><a class="font-medium text-amber-800 underline" href="/blog">Blog</a></li>
    </ul>
    </div>
  </section>
</BaseLayout>
