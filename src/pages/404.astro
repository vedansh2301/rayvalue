---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon';
import { btnPrimary } from '../components/ui/buttons';
---
<BaseLayout title="Page not found" description="That page does not exist. Try the solar payback calculators." path="/404" noindex canonical={false}>
  <section class="shell py-16">
    <div class="max-w-(--container-prose)">
      <h1 class="text-3xl font-bold text-stone-900">Page not found</h1>
      <p class="mt-3 text-stone-700">We could not find that page. Start with a calculator, or pick one of the links below.</p>
    </div>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      <li>
        <a href="/calculator/florida" class="flex h-full flex-col rounded-xl border border-stone-200 bg-white p-6 shadow-sm hover:border-sun-400">
          <span class="flex items-center gap-3"><Icon name="florida" size={32} class="text-stone-900" /><span class="text-xl font-semibold text-stone-900">Florida calculator</span></span>
          <span class="mt-2 leading-7 text-stone-700">See solar and battery payback on FPL, Duke Energy Florida or TECO rates.</span>
          <span class="mt-3 font-medium text-sun-ink">Check my payback <span aria-hidden="true">&rarr;</span></span>
        </a>
      </li>
      <li>
        <a href="/calculator/california" class="flex h-full flex-col rounded-xl border border-stone-200 bg-white p-6 shadow-sm hover:border-sun-400">
          <span class="flex items-center gap-3"><Icon name="california" size={32} class="text-stone-900" /><span class="text-xl font-semibold text-stone-900">California calculator</span></span>
          <span class="mt-2 leading-7 text-stone-700">See solar and battery payback on PG&amp;E, SCE or SDG&amp;E rates.</span>
          <span class="mt-3 font-medium text-sun-ink">Check my payback <span aria-hidden="true">&rarr;</span></span>
        </a>
      </li>
    </ul>
    <p class="mt-6"><a href="/quotes" class={btnPrimary}>Get quotes<span aria-hidden="true">&rarr;</span></a></p>
    <ul class="mt-8 flex flex-wrap gap-x-5 gap-y-1">
      <li><a class="inline-flex min-h-11 items-center font-medium text-sun-ink underline underline-offset-4" href="/">Home</a></li>
      <li><a class="inline-flex min-h-11 items-center font-medium text-sun-ink underline underline-offset-4" href="/guides">Guides</a></li>
      <li><a class="inline-flex min-h-11 items-center font-medium text-sun-ink underline underline-offset-4" href="/blog">Blog</a></li>
    </ul>
  </section>
</BaseLayout>
