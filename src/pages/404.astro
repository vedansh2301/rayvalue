---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { btnPrimary, btnOnDark } from '../components/ui/buttons';
import { liveCalculators } from '../lib/home/global-home';
import { countryMenu } from '../lib/nav';
import { loadMenuSegments } from '../lib/country-nav-load';

const calculators = liveCalculators();
const groups = countryMenu(await loadMenuSegments());
---
<BaseLayout title="Page not found" description="That page does not exist. Pick your country or open a solar payback calculator." path="/404" noindex canonical={false}>
  <PageHero title="We could not find that page" pose="confused">
    The link may be old or mistyped. Pick your country, open a calculator or start again from the home page.
    <Fragment slot="actions">
      <a href="/" class={btnPrimary}>Go to the home page</a>
      <a href="/guides" class={btnOnDark}>Browse guides</a>
    </Fragment>
  </PageHero>

  <section class="shell py-12" aria-labelledby="nf-calcs">
    <h2 id="nf-calcs" class="font-display-tight text-2xl text-stone-900 sm:text-3xl">Calculators</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {calculators.map((c) => (
        <li>
          <a href={c.href} class="flex h-full min-h-11 flex-col rounded-xl border border-stone-200 bg-white p-4 no-underline hover:border-sun-500 hover:bg-sun-50">
            <span class="text-sm font-medium text-sun-ink">{c.country}</span>
            <span class="text-lg font-semibold text-stone-900">{c.label}</span>
            <span class="mt-1 text-stone-700">{c.fact}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="shell pb-16" aria-labelledby="nf-countries">
    <h2 id="nf-countries" class="font-display-tight text-2xl text-stone-900 sm:text-3xl">Countries</h2>
    <div class="mt-5 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      {groups.map((g) => (
        <div role="group" aria-label={g.region}>
          <p class="font-semibold text-stone-900">{g.region}</p>
          <ul class="mt-1">
            {g.items.map((c) => <li><a class="inline-flex min-h-11 items-center text-sun-ink underline underline-offset-4 hover:text-stone-900" href={c.href}>{c.name}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
