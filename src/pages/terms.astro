import PagePending from '../components/PagePending.astro';
import { UNREVIEWED_PAGES } from '../lib/seo/unreviewed-pages';

const path = '/terms';
---
<BaseLayout title="Terms" description="Terms of use for RayValue." path={path} noindex={UNREVIEWED_PAGES.has(path)}>
